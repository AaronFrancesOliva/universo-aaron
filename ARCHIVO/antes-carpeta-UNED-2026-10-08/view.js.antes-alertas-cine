  let solHover = null, nebHover = null, coreHover = false, coreNHover = null;
  canvas.addEventListener("mousedown", (e) => {
    arrastre = { x: e.clientX, y: e.clientY, movido: 0, mover: e.button === 2 || e.button === 1 || e.shiftKey };
