  const cometas = tareas.array().filter((t) => { const d = diasHasta(t.fecha); return d >= 0 && d <= HORIZ_COMETA; }).map((t) => {
    const k = asigDeTexto(t.text), tipo = tipoCometa(t.text);
    // dirección fija desde su destino, algo hacia arriba para que no se pierda en el disco
    const a = rndK() * Math.PI * 2, y = 0.25 + rndK() * 0.6, r = Math.sqrt(1 - y * y);
