      // estela continua
      const fin = proy(suma(P, cola), P, L);
      const g0 = ctx.createLinearGradient(q[0], q[1], fin[0], fin[1]);
      g0.addColorStop(0, urg + "aa"); g0.addColorStop(1, urg + "00");
      ctx.globalAlpha = 0.7 * late; ctx.strokeStyle = g0; ctx.lineWidth = Math.max(1, 0.12 * c.tam * S * q[3]);
      ctx.lineCap = "round"; ctx.beginPath(); ctx.moveTo(q[0], q[1]); ctx.lineTo(fin[0], fin[1]); ctx.stroke();
      // cabeza: núcleo blanco con halo de su color
      const rr = Math.max(2.5, 0.22 * c.tam * S * q[3]) * (0.9 + 0.1 * Math.sin(t * 3 + c.dias));
      const g = ctx.createRadialGradient(q[0], q[1], 0, q[0], q[1], rr * 3);
      g.addColorStop(0, "#ffffff"); g.addColorStop(0.18, urg + "ee"); g.addColorStop(0.5, urg + "44"); g.addColorStop(1, urg + "00");
      ctx.globalAlpha = late; ctx.fillStyle = g; ctx.beginPath(); ctx.arc(q[0], q[1], rr * 3, 0, Math.PI * 2); ctx.fill();
