};
const cuenta = (ms) => {
  const s = Math.floor(Math.abs(ms) / 1000);
  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
  const txt = `${d ? d + "d " : ""}${pad(h)}:${pad(m)}:${pad(s % 60)}`;
  return ms < 0 ? `VENCIDO +${txt}` : `T-${txt}`;
};
