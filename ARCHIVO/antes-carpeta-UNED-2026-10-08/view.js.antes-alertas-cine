        etiqueta(`AÑO ${A.a} ⇄ AÑO ${B.a} · ${g.rel.length} RELACIÓN${g.rel.length === 1 ? "" : "ES"}`, sX[0], sX[1] - R - 10, cM, 0.6, 8);
