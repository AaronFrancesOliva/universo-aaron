      const { P } = posCometa(c), q = proy(P, P, 2);
      c.sx = q[0]; c.sy = q[1];
      if (q[0] < -60 || q[0] > W + 60 || q[1] < -60 || q[1] > H + 60) continue;
      const urg = c.dias <= 2 ? "#ff4d6a" : c.dias <= 7 ? "#ffb547" : c.k && gal[c.k] ? gal[c.k].color : "#e8fbff";
      const late = c.dias <= 2 ? 0.65 + 0.35 * Math.sin(t * 5) : 1;
      const cerca = 1 - c.dias / HORIZ_COMETA; // 0 lejos … 1 el día del plazo
      // cola: sale por detrás, apuntando al lado contrario de su destino, y crece con la urgencia
      const L = (0.8 + 5.5 * cerca) * c.tam;
      const cola = c.dir.map((v) => v * L);
      for (const e of c.cola) {
        const u = (e.u + t * 0.12) % 1; // partículas que fluyen hacia atrás
        const abre = u * 0.35 * L * e.lado;
