        ctx.globalAlpha = (1 - u) * 0.55 * late; ctx.fillStyle = u < 0.3 ? "#ffffff" : urg;
        const z = Math.max(0.8, (1.8 - u) * 0.9 * pp[3]);
        ctx.fillRect(pp[0] - z / 2, pp[1] - z / 2, z, z);
