    if (t - estacion.revisado > 60) { estacion.revisado = t; revisarCopia(); } // cada minuto: lo hace Obsidian en local, no gasta tokens
    const E = posEstacion(t), [cx, cy, , cf] = proy(E, E, 8), esc = S * cf;
