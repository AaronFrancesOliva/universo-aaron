if (MODO === "nucleo") {
  modCabecera(root);
  modGalaxia(root); // vista anterior (planeta + lunas): modGrafo(root)
} else if (MODO === "izquierda") {
  modBriefing(root);
  modTutoria(root);
  modSistemas(root);
  modRepasos(root);
  modSemana(root);
  modCalor(root);
} else if (MODO === "derecha") {
  modPrioridades(root);
  modObjetivos(root);
  modRitmo(root);
  modPomodoro(root);
  modRegistro(root);
} else {
  modCabecera(root);
  const grid = el(root, "div", "jv-grid");
  modBriefing(grid);
  modReactor(grid);
  modTutoria(grid);
  modSistemas(grid);
  modPomodoro(grid);
  modObjetivos(grid);
