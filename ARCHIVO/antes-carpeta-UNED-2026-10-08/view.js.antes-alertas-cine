      info.setText(`☄ COMETA · ${c.texto} · ${c.fecha.setLocale("es").toFormat("ccc d LLL")} · ${c.dias === 0 ? "ES HOY" : c.dias === 1 ? "ES MAÑANA" : `FALTAN ${c.dias} DÍAS`} · CLIC PARA ABRIR EL CALENDARIO`);
      canvas.style.cursor = "pointer"; hover = null; solHover = null; return;
    }
    nebHover = !mejor && !solHover ? nebulosas.find((g) => Math.hypot(g.sx - mx, g.sy - my) < g.sr + 6) || null : null;
    if (nebHover) { info.setText(`☁ NEBULOSA AÑO ${nebHover.A.a} ⇄ AÑO ${nebHover.B.a} · ${nebHover.rel.join(" · ") || "SIN RELACIONES"} · CLIC PARA ABRIR SU MEMORIA`); canvas.style.cursor = "pointer"; hover = null; return; }
    // el núcleo de la galaxia (si no se está ya encima de él, para poder señalar sus notas)
