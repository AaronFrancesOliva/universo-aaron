// ---------- Micrófono: dictado de Windows (Win + H) en la terminal ----------
// Pone el foco en la terminal y pulsa Win + H con PowerShell (oculto). Volver a pulsarlo cierra el dictado.
const PULSAR_WIN_H = `Add-Type -Name K -Namespace W -MemberDefinition '[DllImport("user32.dll")] public static extern void keybd_event(byte b, byte s, uint f, UIntPtr e);';`
  + " [W.K]::keybd_event(0x5B,0,0,[UIntPtr]::Zero); [W.K]::keybd_event(0x48,0,0,[UIntPtr]::Zero);"
  + " [W.K]::keybd_event(0x48,0,2,[UIntPtr]::Zero); [W.K]::keybd_event(0x5B,0,2,[UIntPtr]::Zero)";
const dictar = () => {
  const term = app.workspace.getLeavesOfType(TIPO_TERMINAL)[0];
  if (!term) { aviso("No hay ninguna terminal abierta para dictar."); return; }
  app.workspace.setActiveLeaf(term, { focus: true });
  try { term.view.tabManager.focusActive(); } catch {}
  try {
    window.require("child_process").execFile("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", PULSAR_WIN_H],
      { windowsHide: true }, (err) => { if (err) aviso("No se pudo abrir el dictado de Windows: pulsa Win + H."); });
  } catch { aviso("No se pudo abrir el dictado de Windows: pulsa Win + H."); }
};

