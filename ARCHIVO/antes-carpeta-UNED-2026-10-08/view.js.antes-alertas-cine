  // ---------- Cometas: las fechas límite del Calendario que se acercan ----------
  // Cada tarea pendiente con [fecha:: …] (hasta HORIZ_COMETA días vista) es un cometa que viaja hacia el planeta de su
  // asignatura (o hacia el núcleo de la UNED si no es de ninguna): cuanto menos falta, más cerca está y más larga es su
  // cola. Color de la asignatura; ámbar a 7 días y rojo latiendo a 2. Tamaño según el tipo: examen > entrega > hito/aviso.
  const HORIZ_COMETA = 120;
  let semK = 131;
