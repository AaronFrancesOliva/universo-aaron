      el(f, "span", null, dia.setLocale("es").toFormat("ccc").replace(".", "").toUpperCase());
      el(f, "b", null, dia.day);
      const items = [];
      for (const t of CFG.tutorias.filter((t) => t.dia === i + 1)) items.push({ k: t.asig, txt: `Tutoría ${t.ini}-${t.fin}` });
      const reps = temas.where((p) => p.proximo_repaso && (diasHasta(p.proximo_repaso) === n || (n === 0 && diasHasta(p.proximo_repaso) < 0)));
      for (const p of reps) {
        const tarde = diasHasta(p.proximo_repaso) < 0;
        items.push({ k: claveDe(p.asignatura), txt: `Repaso tema ${p.tema}${tarde ? " (atrasado)" : ""}`, ruta: p.file.path, cls: tarde ? "jv-late" : null });
      }
      for (const t of tareas.where((t) => diasHasta(t.fecha) === n)) {
        items.push({ k: asigDeTexto(t.text), txt: limpiar(t.text), ruta: "UNED/PLANIFICACION/Calendario", cls: "jv-ev-fecha" });
      }
      const ev = el(fila, "div", "jv-dia-ev");
      if (!items.length) el(ev, "span", "jv-dim", "—");
