    if (coreHover) { info.setText(`✺ GALAXIA UNED · NÚCLEO: LA CARPETA UNED · ${notasUned.length} NOTAS (PLANIFICACIÓN, LIBROS…) · CLIC PARA ACERCARTE`); canvas.style.cursor = "pointer"; hover = null; return; }
    coreNHover = !mejor && !solHover ? galN.find((g) => !(foco.tipo === "coreN" && foco.g === g.id)
      && Math.hypot(g.scr.sx - mx, g.scr.sy - my) < Math.max(10, g.scr.sr * 0.6)) || null : null;
    if (coreNHover) { info.setText(`✺ ${coreNHover.def.nombre} · NÚCLEO: LA CARPETA ${coreNHover.def.carpeta} · ${coreNHover.proy.length} ${coreNHover.def.unidad} EN ${coreNHover.sis.filter((s) => s.activo).length} SISTEMAS · CLIC PARA ACERCARTE`); canvas.style.cursor = "pointer"; hover = null; return; }
    if (mejor !== hover || !mejor) {
      hover = mejor;
      info.setText(hover
