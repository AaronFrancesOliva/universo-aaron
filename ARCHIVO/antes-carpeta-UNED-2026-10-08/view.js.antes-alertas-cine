      k, tipo, texto: limpiar(t.text), fecha: t.fecha, dias: diasHasta(t.fecha), dir: [Math.cos(a) * r, y, Math.sin(a) * r],
      tam: { examen: 1.6, entrega: 1.2, hito: 0.8, aviso: 0.7 }[tipo],
      cola: Array.from({ length: 46 }, () => ({ u: rndK(), lado: (rndK() - 0.5) * 2, f: rndK() * 6.3 })),
      sx: -99, sy: -99, sr: 6,
