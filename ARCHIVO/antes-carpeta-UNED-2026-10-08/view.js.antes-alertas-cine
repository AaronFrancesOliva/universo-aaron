      const abierto = window.jvMenuExp === "rutas";
      const b = item(cuerpo, "Conexiones", "enlace", g.color, null, rs.length, `jv-sb-sis${abierto ? " jv-sb-exp" : ""}`);
      icono(b, "flecha", "#5f7488").addClass("jv-sb-flecha");
      b.onclick = (e) => { e.stopPropagation(); window.jvMenuExp = abierto ? null : "rutas"; montarMenu(); };
      if (abierto) {
        const sub = el(cuerpo, "div", "jv-sb-planetas");
        for (const tipo of ["uned", "proyecto", "asignatura", "flujo"]) {
          const xs = rs.filter((r) => r.tipo === tipo);
          if (!xs.length) continue;
          if (window.jvGalSel !== "UNED") el(sub, "div", "jv-sb-cuatri", { proyecto: "Entre planetas", asignatura: "Con la UNED", flujo: "Flujos de datos" }[tipo] || "");
          for (const r of xs) item(sub, `${r.nomDe} ${r.tipo === "flujo" ? "→" : "⇄"} ${r.nomA}`, "enlace", extremo(r.de).color, { tipo: "planeta", k: r.de }).title = r.tema;
        }
      }
    }
    // pie: ayuda con los controles
    const pie = el(panel, "div", "jv-sb-pie");
    const bAyuda = item(pie, "Controles", "ayuda", "#8aa4b8", null, null, window.jvMenuAyuda ? "jv-sb-exp" : "");
    bAyuda.onclick = (e) => { e.stopPropagation(); window.jvMenuAyuda = !window.jvMenuAyuda; montarMenu(); };
    if (window.jvMenuAyuda) {
      const ay = el(pie, "div", "jv-sb-ayuda");
      for (const [k, v] of [["Arrastrar", "girar"], ["Botón dcho. / Shift", "moverte"], ["WASD · Q/E", "volar"], ["Rueda · Ctrl ±", "zoom"], ["Clic en un sol", "acercarte"], ["Doble clic", "galaxia entera"]]) {
        const f = el(ay, "div"); el(f, "kbd", null, k); el(f, "span", null, v);
      }
    }
    marcar();
  };
  const marcar = () => {
    const actual = JSON.stringify(foco);
    menu.querySelectorAll(".jv-nav-i").forEach((b) => b.toggleClass("jv-nav-on", b.dataset.foco === actual));
  };
  montarMenu();
  // los botones de la esquina y los clics en el lienzo también mueven el foco: el menú los sigue
  const seguir = () => setTimeout(() => {
    const gal = galaxiaDeFoco(foco);
    if (gal !== window.jvGalSel) { window.jvGalSel = gal; montarMenu(); } else marcar();
  }, 0);
  bUni.addEventListener("click", seguir); bGal.addEventListener("click", seguir); bNuc.addEventListener("click", seguir);
  canvas.addEventListener("click", seguir);
  canvas.addEventListener("dblclick", seguir);

  // el foco empieza ya colocado (sin animación desde cero)
  const t0 = performance.now() / 1000;
  for (const s of sistemas) s.c = solPos(s, t0);
  const o0 = objetivo(t0); F[0] = o0[0]; F[1] = o0[1]; F[2] = o0[2];
  setTimeout(() => { medir(); bucle(); }, 30);
};

