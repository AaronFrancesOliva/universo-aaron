    caja(0.42, -0.75, 0.15, 0.3 + t * 0.05);           // módulo del anillo grande
    caja(0.32, 1.35, 2.05, 0.3 - t * 0.08);            // módulo del anillo pequeño
    caja(0.26, 3.6, 4.3, 0.3); caja(0.3, -3.2, -2.4, 0.3); // módulos de servicio
