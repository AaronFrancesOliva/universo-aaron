      const b = 0.28 + 0.72 * Math.max(0, n[0] * LUZ[0] + n[1] * LUZ[1] + n[2] * LUZ[2]);
      return `rgb(${Math.round(128 * b * k + 14)}, ${Math.round(168 * b * k + 22)}, ${Math.round(200 * b * k + 36)})`; // acero con tinte cian (estética JARVIS)
    };
