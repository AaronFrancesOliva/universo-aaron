// ---------- Concentración (pomodoro) ----------
const modPomodoro = (parent) => {
  const b = panel(parent, "MODO CONCENTRACIÓN", "jv-a-pomo");
  const KEY = "jarvis-pomodoro";
  const DUR = { foco: CFG.pomodoro.foco * 60000, descanso: CFG.pomodoro.descanso * 60000 };
  const hoyISO = moment().format("YYYY-MM-DD");
  let pomo = store.get(KEY);
  if (!pomo || !DUR[pomo.modo]) pomo = { modo: "foco", fin: null, resto: DUR.foco, dia: hoyISO, ciclos: 0 };
  if (pomo.dia !== hoyISO) { pomo.dia = hoyISO; pomo.ciclos = 0; }
  store.set(KEY, pomo);

  const PR = 56, PCIRC = 2 * Math.PI * PR;
  const pWrap = el(b, "div");
  pWrap.innerHTML = `<svg viewBox="0 0 140 140" class="jv-pomo">
    <circle cx="70" cy="70" r="${PR}" class="jv-ring-bg"/>
    <circle cx="70" cy="70" r="${PR}" class="jv-pomo-arc" transform="rotate(-90 70 70)" stroke-dasharray="${PCIRC} ${PCIRC}"/>
    <text x="70" y="74" class="jv-pomo-t">25:00</text>
    <text x="70" y="92" class="jv-pomo-m">FOCO</text>
  </svg>`;
  const pSvg = pWrap.querySelector("svg");
  const pArc = pWrap.querySelector(".jv-pomo-arc");
  const pT = pWrap.querySelector(".jv-pomo-t");
  const pM = pWrap.querySelector(".jv-pomo-m");
  const btns = el(b, "div", "jv-btns");
  const bPlay = el(btns, "button", "jv-btn", "INICIAR");
  const bReset = el(btns, "button", "jv-btn", "REINICIAR");
  const bSkip = el(btns, "button", "jv-btn", "SALTAR");
  const pInfo = el(b, "div", "jv-pomo-info");

  const pitido = () => {
    try {
      const ctx = new AudioContext();
      [0, 0.28, 0.56].forEach((t) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.frequency.value = 880;
        o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.15, ctx.currentTime + t);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 0.22);
        o.start(ctx.currentTime + t); o.stop(ctx.currentTime + t + 0.24);
      });
    } catch {}
  };
  const restante = () => (pomo.fin ? pomo.fin - Date.now() : pomo.resto);
  const cambiarModo = (contar) => {
    if (contar && pomo.modo === "foco") pomo.ciclos++;
    pomo.modo = pomo.modo === "foco" ? "descanso" : "foco";
    pomo.fin = null;
    pomo.resto = DUR[pomo.modo];
    store.set(KEY, pomo);
  };
  const pintar = () => {
    // Otra vista del panel puede haber cambiado el estado
    const guardado = store.get(KEY);
    if (guardado) pomo = guardado;
    if (pomo.fin && pomo.fin <= Date.now()) {
      const eraFoco = pomo.modo === "foco";
      cambiarModo(true);
      pitido();
      aviso(eraFoco ? "J.A.R.V.I.S.: bloque de foco completado. Toca descansar." : "J.A.R.V.I.S.: descanso terminado. Vuelta al estudio.");
    }
    const ms = Math.max(0, restante());
    pT.textContent = `${pad(Math.floor(ms / 60000))}:${pad(Math.floor((ms % 60000) / 1000))}`;
    pM.textContent = pomo.modo === "foco" ? "FOCO" : "DESCANSO";
    pSvg.classList.toggle("jv-break", pomo.modo === "descanso");
    pArc.setAttribute("stroke-dasharray", `${(PCIRC * ms) / DUR[pomo.modo]} ${PCIRC}`);
    bPlay.setText(pomo.fin ? "PAUSAR" : ms < DUR[pomo.modo] ? "REANUDAR" : "INICIAR");
    pInfo.setText(`CICLOS HOY: ${pomo.ciclos} · ${pomo.ciclos * CFG.pomodoro.foco} MIN DE FOCO`);
  };
  bPlay.onclick = () => {
    if (pomo.fin) { pomo.resto = Math.max(0, pomo.fin - Date.now()); pomo.fin = null; }
    else pomo.fin = Date.now() + pomo.resto;
    store.set(KEY, pomo); pintar();
  };
  bReset.onclick = () => { pomo.fin = null; pomo.resto = DUR[pomo.modo]; store.set(KEY, pomo); pintar(); };
  bSkip.onclick = () => { cambiarModo(false); pintar(); };
  ticks.push(pintar);
};

// ---------- Objetivos (cuenta atrás) ----------
const modObjetivos = (parent) => {
  const max = MODO === "derecha" ? CFG.maxObjetivosLateral : CFG.maxObjetivos;
  const b = panel(parent, "OBJETIVOS · CUENTA ATRÁS", "jv-a-obj", `${tareas.length} PENDIENTES`);
  const relojes = [];
  const completar = async (t) => {
    const file = app.vault.getAbstractFileByPath(t.path);
    if (!file) return;
    await app.vault.process(file, (data) => {
      const lineas = data.split("\n");
      if (lineas[t.line] && lineas[t.line].includes("- [ ]")) lineas[t.line] = lineas[t.line].replace("- [ ]", "- [x]");
      return lineas.join("\n");
    });
  };
  if (!tareas.length) el(b, "div", "jv-empty", "Sin objetivos pendientes en el Calendario.");
  for (const t of tareas.slice(0, max)) {
    const k = asigDeTexto(t.text);
    const objetivo = momentoDe(t);
    const fila = el(b, "div", "jv-obj");
    const chk = el(fila, "button", "jv-chk");
    chk.title = "Marcar como hecho (pulsa dos veces para confirmar)";
    let armado = null;
    chk.onclick = () => {
      if (armado) { clearTimeout(armado); chk.setText("✓"); completar(t); return; }
      chk.addClass("jv-armed"); chk.setText("?");
      armado = setTimeout(() => { armado = null; chk.removeClass("jv-armed"); chk.setText(""); }, 3000);
    };
    const chip = el(fila, "span", "jv-chip", k || "UNED");
    chip.style.color = k ? CFG.asig[k].color : "var(--dim)";
    const cuerpo = el(fila, "div", "jv-obj-t");
    el(cuerpo, "div", null, limpiar(t.text));
    const meta = el(cuerpo, "div", "jv-obj-f", moment(objetivo).locale("es").format("ddd D MMM YYYY · HH:mm"));
    if (/aprox|no publicad|según Ágora/i.test(t.text)) el(meta, "span", "jv-tag", "POR CONFIRMAR");
    const cd = el(fila, "div", "jv-cd");
    const barra = el(el(fila, "div", "jv-bar"), "div");
    relojes.push({ fila, cd, barra, objetivo });
  }
  if (tareas.length > max) {
    enlace(el(b, "div", "jv-more"), "UNED/PLANIFICACION/Calendario", `+${tareas.length - max} más en el Calendario ▸`);
  }
  ticks.push(() => {
    const ahora = Date.now();
    for (const r of relojes) {
      const ms = r.objetivo - ahora;
      const dias = ms / 86400000;
      r.cd.setText(cuenta(ms));
      r.fila.toggleClass("jv-crit", dias <= 3);
      r.fila.toggleClass("jv-warn", dias > 3 && dias <= 14);
      r.barra.style.width = `${Math.max(2, Math.min(100, 100 * (1 - dias / CFG.horizonte)))}%`;
    }
  });
};

