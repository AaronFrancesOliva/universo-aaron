  const pintar = () => {
    const off = window.jvSemOffset || 0;
    const lunes = HOY.startOf("week").plus({ weeks: off });
    tit.setText(off === 0 ? "SEMANA EN CURSO" : off === 1 ? "SEMANA QUE VIENE" : off === -1 ? "SEMANA PASADA" : `SEMANA ${off > 0 ? "+" : "−"}${Math.abs(off)}`);
