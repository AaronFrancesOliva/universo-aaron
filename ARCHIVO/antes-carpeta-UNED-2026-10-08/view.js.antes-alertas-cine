      canvas.style.cursor = "pointer"; hover = null; solHover = null; return;
    }
    cometaHover = !mejor ? cometas.find((c) => Math.hypot(c.sx - mx, c.sy - my) < Math.max(10, c.sr)) || null : null;
    if (cometaHover) {
