  const proy = (p, centro = null, rad = 1.1) => {
    const [x1, y1, z2] = camZ(p);
    const D = 4.5 * VIEW_R / zoomAct;
    const f = D / Math.max(D * 0.2, D - z2);
    const zc = centro ? camZ(centro)[2] : camZ([0, 0, 0])[2];
    return [W / 2 + x1 * f * S, H / 2 + y1 * f * S, Math.max(0, Math.min(1, (z2 - zc + rad) / (2 * rad))), f];
  };

  const medir = () => {
    if (MODO === "nucleo") {
      const vc = root.closest(".view-content") || root.parentElement;
      const otros = root.offsetHeight - caja.offsetHeight;
      caja.style.height = `${Math.max(380, vc.clientHeight - otros - 40)}px`;
    }
