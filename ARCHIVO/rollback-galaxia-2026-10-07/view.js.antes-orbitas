      ctx.lineWidth = Math.max(1, rh * 0.1); ctx.globalAlpha = 0.45;
      ctx.beginPath(); ctx.ellipse(cx, cy, rh * 1.3, rh * 1.15, 0, Math.PI * 0.1, Math.PI * 0.9); ctx.stroke();
      ctx.shadowBlur = 0; ctx.globalAlpha = 1;
