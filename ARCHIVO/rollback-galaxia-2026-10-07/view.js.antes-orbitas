  };

  // ---------- AARON: agujero negro ----------
  const O = [0, 0, 0];
  const posDisco = (r, a0, h, t) => { const a = a0 + t * (0.55 / Math.pow(r, 1.5)); return enDisco([Math.cos(a) * r, h, Math.sin(a) * r]); };
  const dibujarAgujero = (t, fase) => { // fase 0: lo de detrás del horizonte · fase 1: horizonte y lo de delante
    const [cx, cy, , cf] = proy(O), rh = R_BH * S * cf;
    if (fase === 0) {
      halo(cx, cy, rh * 7, "#7b5cff", 0.45);
      halo(cx, cy, rh * 3.5, "#ff6fae", 0.25);
