  // Núcleo: polvo, retícula, anillos y rayos (como el planeta de antes)
  const polvoN = [];
  for (let i = 0; i < 450; i++) { const [x, y, z] = fib(i, 450), k = 1 + (rnd() - 0.5) * 0.04; polvoN.push([x * k, y * k, z * k]); }
  const reticula = [];
  for (let m = 0; m < 8; m++) {
    const lon = (m / 8) * Math.PI, pts = [];
