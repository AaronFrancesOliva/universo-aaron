      h.addColorStop(0, "#000000"); h.addColorStop(0.75, "#000000"); h.addColorStop(1, "#00000000");
      ctx.fillStyle = h; ctx.beginPath(); ctx.arc(cx, cy, rh * 1.25, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = "#fff1ff"; ctx.shadowColor = "#d6a8ff"; ctx.shadowBlur = 22; ctx.lineWidth = Math.max(1, rh * 0.06);
      ctx.globalAlpha = 0.9 + 0.1 * Math.sin(t * 2);
      ctx.beginPath(); ctx.arc(cx, cy, rh * 1.02, 0, Math.PI * 2); ctx.stroke();
      ctx.lineWidth = 0.8; ctx.globalAlpha = 0.5; ctx.shadowBlur = 8;
      ctx.beginPath(); ctx.arc(cx, cy, rh * 1.12, 0, Math.PI * 2); ctx.stroke();
      ctx.shadowBlur = 0; ctx.globalAlpha = 1;
