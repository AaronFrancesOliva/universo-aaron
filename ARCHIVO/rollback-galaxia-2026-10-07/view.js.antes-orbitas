      if ((s[2] >= 0.5) !== (fase === 1)) continue;
      const tw = 0.7 + 0.3 * Math.sin(t * 3 + d.t * 30);
      ctx.globalAlpha = (fase === 1 ? 0.75 : 0.5) * tw; ctx.fillStyle = d.c;
      const z = 1.3 * s[3];
      ctx.fillRect(s[0] - z / 2, s[1] - z / 2, z, z);
    }
    ctx.globalAlpha = 1;
    if (fase === 0) {
      // lente gravitatoria: el disco de detrás se ve curvado por encima y por debajo del horizonte
      const g = ctx.createLinearGradient(cx - rh * 1.8, cy, cx + rh * 1.8, cy);
      g.addColorStop(0, "#a77bff00"); g.addColorStop(0.3, "#ff6fae"); g.addColorStop(0.5, "#fff4e0"); g.addColorStop(0.7, "#ffb070"); g.addColorStop(1, "#a77bff00");
      ctx.strokeStyle = g; ctx.shadowColor = "#ff9ad5"; ctx.shadowBlur = 18;
