    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };
  const circulo = (c, r, n = 72) => Array.from({ length: n + 1 }, (_, i) => { const a = (i / n) * Math.PI * 2; return [c[0] + Math.cos(a) * r, c[1], c[2] + Math.sin(a) * r]; });
  const halo = (x, y, r, color, alpha) => {
    const g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, color + "cc"); g.addColorStop(0.25, color + "55"); g.addColorStop(1, color + "00");
    ctx.globalAlpha = alpha; ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
  };
  const etiqueta = (txt, x, y, color, alpha, tam = 12) => {
    ctx.globalAlpha = alpha; ctx.font = `bold ${tam}px Orbitron, 'Share Tech Mono', monospace`; ctx.textAlign = "center";
    ctx.fillStyle = color; ctx.shadowColor = color; ctx.shadowBlur = 8;
    ctx.fillText(txt, x, y); ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  };

  // ---------- Dibujo de cada cuerpo ----------
  const dibujarNucleo = (t) => {
    const [cx, cy, , cf] = proy(J, J), rr = S * cf;
    halo(cx, cy, rr * 3.2, "#3ee8ff", 0.35);
    for (const pts of rr > 60 ? reticula : retPeq) trazo(pts.map(enJ), "#3ee8ff", 0.7, 0.04, 0.14, 0, null, J, 1.1);
    ctx.fillStyle = "#3ee8ff";
