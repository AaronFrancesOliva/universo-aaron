  let yaw = 0.6, pitch = -0.55, hover = null, arrastre = null;
  const VIEW_R = anios[0].R + anios[0].radio + 0.6; // la vista inicial muestra el núcleo y el sistema del año 1
  let foco = window.jvFoco || { tipo: "galaxia" }; // galaxia | nucleo | anio
