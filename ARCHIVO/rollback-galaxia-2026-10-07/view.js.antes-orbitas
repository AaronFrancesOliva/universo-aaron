    }
    return [cx, cy, rh];
  };
  // Enlace AARON ↔ JARVIS: el humano y su agente
  const dibujarVinculo = (t) => {
    const len = Math.hypot(...J), dir = J.map((v) => v / len);
    const ini = dir.map((v) => v * (DISCO[1] + 0.05)), fin = dir.map((v) => v * (len - 1.2));
