  const ro = new ResizeObserver(medir);
  ro.observe(caja);
  const vc = root.closest(".view-content");
  if (vc) ro.observe(vc);

  const trazo = (pts, color, ancho, aDetras, aDelante, brillo, saltar, centro, rad) => {
    const P = pts.map((q) => proy(q, centro, rad));
