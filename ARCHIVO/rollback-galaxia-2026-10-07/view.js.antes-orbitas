// ---------- Ritmo hasta el examen ----------
// Temas que faltan (con el mismo peso por estado que el progreso) ÷ semanas hasta cada hito.
// Hitos: las tareas "tener estudiados los temas X-Y" del Calendario y la 1.ª semana de exámenes;
// se muestra el más exigente. Umbrales (criterio de Jarvis): ≤ 1 tema/sem nominal, ≤ 2 atención.
const modRitmo = (parent) => {
  const examen = tareas.where((t) => /^Exámenes: 1\.ª semana/.test(t.text)).first();
  const b = panel(parent, "RITMO HASTA EL EXAMEN", "jv-a-ritmo", "TEMAS / SEMANA");
  const num = (n) => n.toLocaleString("es", { maximumFractionDigits: 1 });
  for (const x of progreso) {
    const total = x.a.temasExamen ?? x.a.temas;
    const fila = el(b, "div", "jv-sys");
    el(fila, "span", "jv-sys-k", x.k).style.color = x.a.color;
    if (!total || !examen) {
      el(fila, "span", "jv-dim", "—");
      el(fila, "span", "jv-status jv-dim", "SIN DATOS");
      el(fila, "div", "jv-sys-d", !total ? "Sin nº de temas (el material está en Ágora)." : "Falta la fecha de examen en el Calendario.");
      continue;
    }
    const notas = temas.where((p) => p.asignatura === x.a.nombre);
    const falta = (hasta) => hasta - notas.where((p) => +p.tema <= hasta).array().reduce((s, p) => s + (PESO[p.estado] ?? 0), 0);
    const hitos = tareas.where((t) => asigDeTexto(t.text) === x.k && /tener estudiados/.test(t.text) && diasHasta(t.fecha) > 0)
      .array().map((t) => {
        const m = t.text.match(/temas (\d+)-(\d+)/);
        return m && { hasta: Math.min(+m[2], total), fecha: t.fecha, txt: `temas ${m[1]}-${m[2]}` };
      }).filter(Boolean);
    hitos.push({ hasta: total, fecha: examen.fecha, txt: "examen (1.ª semana)" });
    const calc = hitos.map((h) => {
      const sem = Math.max(diasHasta(h.fecha) / 7, 1 / 7);
      return { ...h, sem, falta: falta(h.hasta), ritmo: falta(h.hasta) / sem };
    }).filter((h) => h.falta > 0);
    if (!calc.length) {
      el(fila, "span", null, "al día");
      el(fila, "span", "jv-status jv-st-ok", "NOMINAL");
      el(fila, "div", "jv-sys-d", "Todos los temas estudiados.");
      continue;
    }
    const peor = calc.reduce((a, h) => (h.ritmo > a.ritmo ? h : a));
    el(fila, "span", null, `${num(peor.ritmo)} temas/sem`);
    const [cls, txt] = peor.ritmo > 2 ? ["jv-st-crit", "CRÍTICO"] : peor.ritmo > 1 ? ["jv-st-warn", "ATENCIÓN"] : ["jv-st-ok", "NOMINAL"];
    el(fila, "span", `jv-status ${cls}`, txt);
    el(fila, "div", "jv-sys-d",
      `Faltan ${num(peor.falta)} de ${peor.hasta} temas para ${peor.txt} · ${peor.fecha.setLocale("es").toFormat("d LLL")} (${num(peor.sem)} sem)`);
  }
};

// ---------- Semana en curso (navegable) ----------
// Lunes a domingo: tutorías (CFG), repasos (proximo_repaso de las notas de tema) y fechas del Calendario.
// Los repasos atrasados se muestran en el día de hoy. Con ◀ ▶ se pasa de semana; HOY vuelve a la actual.
// El desplazamiento se guarda en window para que no se pierda cuando Dataview repinta la vista.
const modSemana = (parent) => {
  const fmt = (d) => d.setLocale("es").toFormat("d LLL");
  const b = panel(parent, "SEMANA EN CURSO", "jv-a-sem", " ");
  const cab = b.parentElement;
  const tit = cab.querySelector(".jv-panel-t"), rango = cab.querySelector(".jv-panel-x");
  const nav = el(b, "div", "jv-sem-nav");
  const prev = el(nav, "button", "jv-sem-btn", "◀");
  const hoyB = el(nav, "button", "jv-sem-btn jv-sem-hoy", "HOY");
  const next = el(nav, "button", "jv-sem-btn", "▶");
  const lista = el(b, "div", "jv-sem-lista");
  const pintar = () => {
    const off = window.jvSemOffset || 0;
    const lunes = HOY.startOf("week").plus({ weeks: off });
    tit.setText(off === 0 ? "SEMANA EN CURSO" : off === 1 ? "SEMANA QUE VIENE" : off === -1 ? "SEMANA PASADA" : `SEMANA ${off > 0 ? "+" : "−"}${Math.abs(off)}`);
    rango.setText(`${fmt(lunes)} – ${fmt(lunes.plus({ days: 6 }))}`.toUpperCase());
    hoyB.toggleClass("jv-off", off === 0);
    lista.empty();
    for (let i = 0; i < 7; i++) {
      const dia = lunes.plus({ days: i });
      const n = diasHasta(dia);
      const fila = el(lista, "div", "jv-dia");
      fila.toggleClass("jv-hoy", n === 0);
      fila.toggleClass("jv-pasado", n < 0);
      const f = el(fila, "div", "jv-dia-f");
      el(f, "span", null, dia.setLocale("es").toFormat("ccc").replace(".", "").toUpperCase());
      el(f, "b", null, dia.day);
      const items = [];
      for (const t of CFG.tutorias.filter((t) => t.dia === i + 1)) items.push({ k: t.asig, txt: `Tutoría ${t.ini}-${t.fin}` });
      const reps = temas.where((p) => p.proximo_repaso && (diasHasta(p.proximo_repaso) === n || (n === 0 && diasHasta(p.proximo_repaso) < 0)));
      for (const p of reps) {
        const tarde = diasHasta(p.proximo_repaso) < 0;
        items.push({ k: claveDe(p.asignatura), txt: `Repaso tema ${p.tema}${tarde ? " (atrasado)" : ""}`, ruta: p.file.path, cls: tarde ? "jv-late" : null });
      }
      for (const t of tareas.where((t) => diasHasta(t.fecha) === n)) {
        items.push({ k: asigDeTexto(t.text), txt: limpiar(t.text), ruta: "PLANIFICACION/Calendario", cls: "jv-ev-fecha" });
      }
      const ev = el(fila, "div", "jv-dia-ev");
      if (!items.length) el(ev, "span", "jv-dim", "—");
      for (const it of items) {
        const c = el(ev, "div", `jv-ev ${it.cls || ""}`);
        el(c, "span", "jv-ev-k", it.k || "UNED").style.color = it.k ? CFG.asig[it.k].color : "var(--dim)";
        if (it.ruta) enlace(c, it.ruta, it.txt); else el(c, "span", null, it.txt);
      }
    }
  };
  const mover = (d) => { window.jvSemOffset = d === 0 ? 0 : (window.jvSemOffset || 0) + d; pintar(); };
  prev.onclick = () => mover(-1);
  next.onclick = () => mover(1);
  hoyB.onclick = () => mover(0);
  pintar();
};

// ---------- Mapa de calor de actividad ----------
// Últimas semanas (columnas) × lunes a domingo (filas). Cada día suma: notas de las asignaturas
// creadas o editadas ese día, repasos hechos (ultimo_repaso, valen 2) y tareas marcadas en la nota diaria.
const modCalor = (parent) => {
  const SEMANAS = 16;
  const act = new Map(); // "yyyy-MM-dd" → { notas, repasos, tareas }
  const sumar = (fecha, campo, n = 1) => {
    const k = fecha.toFormat("yyyy-MM-dd");
    const d = act.get(k) || { notas: 0, repasos: 0, tareas: 0 };
    d[campo] += n;
    act.set(k, d);
  };
  const carpetas = claves.map((k) => CFG.asig[k].carpeta + "/");
  for (const f of app.vault.getMarkdownFiles().filter((f) => carpetas.some((c) => f.path.startsWith(c)))) {
    const crea = dv.luxon.DateTime.fromMillis(f.stat.ctime), edita = dv.luxon.DateTime.fromMillis(f.stat.mtime);
    sumar(crea, "notas");
    if (!edita.hasSame(crea, "day")) sumar(edita, "notas");
  }
  for (const p of temas.where((p) => p.ultimo_repaso && p.ultimo_repaso.toFormat)) sumar(p.ultimo_repaso, "repasos");
  for (const d of dv.pages(`"${RUTA_DIARIO}"`).where((p) => p.fecha && p.fecha.toFormat)) {
    const hechas = d.file.tasks.where((t) => t.completed).length;
    if (hechas) sumar(d.fecha, "tareas", hechas);
  }
  const puntos = (d) => (d ? d.notas + 2 * d.repasos + d.tareas : 0);
  const nivel = (n) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4);

  // Racha: días seguidos con actividad hasta hoy (si hoy aún no hay nada, cuenta desde ayer)
  let racha = 0;
  for (let d = puntos(act.get(HOY.toFormat("yyyy-MM-dd"))) ? HOY : HOY.minus({ days: 1 }); puntos(act.get(d.toFormat("yyyy-MM-dd"))); d = d.minus({ days: 1 })) racha++;
  let activos30 = 0;
  for (let i = 0; i < 30; i++) if (puntos(act.get(HOY.minus({ days: i }).toFormat("yyyy-MM-dd")))) activos30++;

  const b = panel(parent, "ACTIVIDAD", "jv-a-calor", `${SEMANAS} SEMANAS`);
  const st = el(b, "div", "jv-stats");
  const dato = (etq, n) => { const s = el(st, "span", null, `${etq} `); el(s, "b", null, n); };
  dato("RACHA", `${racha} d`);
  dato("ACTIVOS (30 d)", activos30);

  const rej = el(b, "div", "jv-calor");
  rej.style.gridTemplateColumns = `auto repeat(${SEMANAS}, 1fr)`;
  const inicio = HOY.startOf("week").minus({ weeks: SEMANAS - 1 });
  // Fila de meses: el nombre aparece en la semana en que empieza el mes
  el(rej, "span");
  for (let w = 0; w < SEMANAS; w++) {
    const lunes = inicio.plus({ weeks: w });
    const nuevo = w === 0 || lunes.month !== lunes.minus({ weeks: 1 }).month;
    el(rej, "span", "jv-calor-mes", nuevo ? lunes.setLocale("es").toFormat("LLL").replace(".", "").toUpperCase() : "");
  }
  for (let fila = 0; fila < 7; fila++) {
    el(rej, "span", "jv-calor-dia", ["L", "", "X", "", "V", "", "D"][fila]);
    for (let w = 0; w < SEMANAS; w++) {
      const dia = inicio.plus({ weeks: w, days: fila });
      const n = diasHasta(dia);
      const d = act.get(dia.toFormat("yyyy-MM-dd"));
      const c = el(rej, "span", `jv-calor-c jv-n${nivel(puntos(d))}`);
      if (n > 0) { c.addClass("jv-futuro"); continue; }
      if (n === 0) c.addClass("jv-hoy");
      const partes = d ? [d.notas && `${d.notas} nota${d.notas > 1 ? "s" : ""}`, d.repasos && `${d.repasos} repaso${d.repasos > 1 ? "s" : ""}`,
        d.tareas && `${d.tareas} tarea${d.tareas > 1 ? "s" : ""}`].filter(Boolean) : [];
      c.title = `${dia.setLocale("es").toFormat("cccc d LLL")}: ${partes.length ? partes.join(", ") : "sin actividad"}`;
    }
  }
  const ley = el(b, "div", "jv-calor-ley");
  el(ley, "span", null, "MENOS");
  for (let i = 0; i <= 4; i++) el(ley, "span", `jv-calor-c jv-n${i}`);
  el(ley, "span", null, "MÁS");
};

// ---------- Sistema planetario de notas con el reactor en el centro ----------
// Planeta central = la máquina (JARVIS): las notas que no son de ninguna asignatura (planificación,
// red neuronal, memoria, libros…) sobre una esfera 3D con retícula, anillos, partículas y rayos de datos.
// Tres lunas = las asignaturas: cada una es una esfera pequeña con sus notas, orbita alrededor del
// planeta y está unida a él por un haz de datos con pulsos en los dos sentidos (la luna envía sus
// notas a la máquina y la máquina le devuelve conocimiento). Los enlaces entre notas son filamentos.
// Gira sola; se puede arrastrar para girarla y se para al pasar el ratón por un nodo.
const modGrafo = (parent) => {
  const caja = el(parent, "div", "jv-graph");
  const canvas = el(caja, "canvas");
  const capa = el(caja, "div", "jv-graph-reactor");
  capa.innerHTML = svgReactor(false); // en el núcleo, sin porcentaje
  animarAnillos(capa);
  const info = el(caja, "div", "jv-graph-info");
  const ley = el(caja, "div", "jv-graph-ley");
  // Zoom del sistema: botones en la esquina, rueda del ratón y Ctrl + / Ctrl − / Ctrl 0 con el ratón encima.
  // Se guarda en window para que no se pierda cuando Dataview repinta la vista.
  const ZMIN = 0.35, ZMAX = 3;
  const zoomBox = el(caja, "div", "jv-zoom");
  const bMas = el(zoomBox, "button", "jv-zoom-b", "+");
  const zTxt = el(zoomBox, "span", "jv-zoom-v");
  const bMenos = el(zoomBox, "button", "jv-zoom-b", "−");
  const bReset = el(zoomBox, "button", "jv-zoom-b jv-zoom-r", "⟲");
  bMas.title = "Acercar (Ctrl +)"; bMenos.title = "Alejar (Ctrl −)"; bReset.title = "Tamaño normal (Ctrl 0)";
  const zoom = () => window.jvZoom || 1;
  const ponerZoom = (z) => {
    window.jvZoom = Math.max(ZMIN, Math.min(ZMAX, Math.round(z * 100) / 100));
    zTxt.setText(`${Math.round(zoom() * 100)}%`);
    if (W) medir();
  };
  for (const k of claves) {
    const s = el(ley, "span");
    el(s, "span", "jv-dot").style.color = CFG.asig[k].color;
    s.appendText(`${k} ${progreso.find((x) => x.k === k).pct}%`);
  }
  for (const [c, color] of Object.entries(CFG.otrasCarpetas)) {
    const s = el(ley, "span");
    el(s, "span", "jv-dot").style.color = color;
    s.appendText(c);
  }

  // Nodos: todas las notas + los archivos enlazados (PDF, etc.)
  const estadoDe = new Map(temas.array().map((p) => [p.file.path, p.estado]));
  const colorDe = (path) => {
    const top = path.includes("/") ? path.split("/")[0] : "";
    const k = claves.find((k) => path.startsWith(CFG.asig[k].carpeta + "/"));
    return k ? CFG.asig[k].color : CFG.otrasCarpetas[top] || "#7fa9b8";
  };
  const nodos = new Map();
  const add = (path) => {
    if (path.startsWith("PLANIFICACION/Jarvis/")) return null;
    if (!nodos.has(path)) {
      const f = app.vault.getAbstractFileByPath(path);
      if (!f) return null;
      nodos.set(path, {
        path, nombre: f.basename, ext: f.extension, carpeta: f.parent ? f.parent.path : "",
        color: colorDe(path), estado: estadoDe.get(path), vecinos: new Set(),
      });
    }
    return nodos.get(path);
  };
  for (const f of app.vault.getMarkdownFiles()) add(f.path);
  const aristas = [];
  for (const [src, dsts] of Object.entries(app.metadataCache.resolvedLinks)) {
    const a = add(src);
    if (!a) continue;
    for (const dst of Object.keys(dsts)) {
      const b = dst !== src ? add(dst) : null;
      if (!b || a.vecinos.has(b)) continue;
      a.vecinos.add(b); b.vecinos.add(a);
      aristas.push([a, b]);
    }
  }
  const lista = [...nodos.values()].sort((a, b) => a.path.localeCompare(b.path));
  const asigDeRuta = (path) => claves.find((k) => path.startsWith(CFG.asig[k].carpeta + "/"));
  for (const n of lista) n.luna = asigDeRuta(n.path) || null;

  // ---------- Geometría (unidades: radio de la esfera = 1) ----------
  let sem = 11;
  const rnd = () => (sem = (sem * 16807) % 2147483647) / 2147483647;
  const fib = (i, n) => {
    const y = 1 - (2 * (i + 0.5)) / n, r = Math.sqrt(1 - y * y), th = i * Math.PI * (3 - Math.sqrt(5));
    return [Math.cos(th) * r, y, Math.sin(th) * r];
  };
  // Lunas: una por asignatura, con su órbita, inclinación, velocidad y giro propio
  const R_LUNA = 0.34;
  // Cada luna tiene su propia órbita: radio (a, b → elipse), inclinación, velocidad y sentido.
  // Periodos de unos 18-30 s para que se vea que se mueven por su cuenta.
  const ORBITAS = [
    { a: 1.75, b: 1.6, incX: 0.45, incZ: -0.2, vel: 0.34 },
    { a: 2.15, b: 1.95, incX: -0.3, incZ: 0.35, vel: -0.24 },
    { a: 2.5, b: 2.25, incX: 0.15, incZ: 0.55, vel: 0.2 },
  ];
  const lunas = claves.map((k, i) => ({
    k, color: CFG.asig[k].color, pct: progreso.find((x) => x.k === k).pct,
    fase: (i / claves.length) * Math.PI * 2, ...ORBITAS[i % ORBITAS.length], giro: 0.5 + rnd() * 0.4,
    polvo: Array.from({ length: 120 }, (_, j) => fib(j, 120)),
    pulsos: Array.from({ length: 6 }, (_, j) => ({ u: j / 6, sube: j % 2 === 0 })),
  }));
  const lunaDe = Object.fromEntries(lunas.map((m) => [m.k, m]));
  // Posición local de cada nota en su cuerpo (radio 1); el radio y el centro se aplican al dibujar
  const repartir = (ns) => ns.forEach((n, i) => {
    const [x, y, z] = fib(i, ns.length), k = 0.97 + rnd() * 0.06;
    n.p = [x * k, y * k, z * k];
  });
  repartir(lista.filter((n) => !n.luna));
  for (const m of lunas) repartir(lista.filter((n) => n.luna === m.k));
  lista.forEach((n) => {
    n.r = (n.ext === "md" ? 3.2 : 2.2) + Math.min(5, Math.sqrt(n.vecinos.size) * 1.3) + (n.estado ? 1.5 : 0);
    if (n.luna) n.r *= 0.75;
  });
  // Partículas: polvo sobre la superficie y algunas dentro
  const polvo = [];
  for (let i = 0; i < 650; i++) { const [x, y, z] = fib(i, 650), k = 1 + (rnd() - 0.5) * 0.04; polvo.push([x * k, y * k, z * k]); }
  for (let i = 0; i < 220; i++) { const [x, y, z] = fib(Math.floor(rnd() * 650), 650), k = 0.35 + rnd() * 0.55; polvo.push([x * k, y * k, z * k]); }
  // Retícula: meridianos y paralelos
  const reticula = [];
  for (let m = 0; m < 8; m++) {
    const lon = (m / 8) * Math.PI, pts = [];
    for (let i = 0; i <= 64; i++) { const lat = (i / 64) * Math.PI * 2; pts.push([Math.cos(lat) * Math.cos(lon), Math.sin(lat), Math.cos(lat) * Math.sin(lon)]); }
    reticula.push(pts);
  }
  for (const lat of [-0.6, -0.3, 0, 0.3, 0.6]) {
    const pts = [], r = Math.cos(lat), y = Math.sin(lat);
    for (let i = 0; i <= 64; i++) { const a = (i / 64) * Math.PI * 2; pts.push([Math.cos(a) * r, y, Math.sin(a) * r]); }
    reticula.push(pts);
  }
  // Anillos orbitales: brillantes, de bloques de datos y finos; cada uno con su inclinación y velocidad
  const TIPOS = ["luz", "datos", "datos", "fino", "luz", "datos", "fino", "fino"];
  const anillos = TIPOS.map((tipo, i) => ({
    tipo, rad: 1.08 + rnd() * 0.24, incX: (rnd() - 0.5) * 2.4, incZ: (rnd() - 0.5) * 2.4,
    vel: (rnd() < 0.5 ? -1 : 1) * (0.05 + rnd() * 0.2), fase: rnd() * 6.3,
    huecos: Array.from({ length: 96 }, () => rnd() < (tipo === "datos" ? 0.45 : 0.08)),
    color: i % 4 === 3 ? "#4dffb5" : "#3ee8ff",
  }));
  // Rayos de datos que salen de la esfera
  const rayos = Array.from({ length: 110 }, (_, i) => {
    const d = fib(i, 110), ini = 1.04 + rnd() * 0.06;
    return { d, ini, fin: ini + 0.08 + rnd() * rnd() * 0.55, fase: rnd() };
  });

  const infoBase = `NÚCLEO + ${lunas.length} LUNAS · NODOS ${lista.length} · ENLACES ${aristas.length} · ARRASTRA PARA GIRAR · PASA EL RATÓN POR UN NODO`;
  info.setText(infoBase);

  // ---------- Proyección ----------
  const ctx = canvas.getContext("2d");
  let W = 0, H = 0, dpr = 1, S = 100, ladoReactor = 0;
  let yaw = 0.6, pitch = -0.32, hover = null, arrastre = null;
  const paquetes = [];
  const rotar = ([x, y, z], ax, az) => { // inclinación propia de un anillo
    let c = Math.cos(ax), s = Math.sin(ax);
    [y, z] = [y * c - z * s, y * s + z * c];
    c = Math.cos(az); s = Math.sin(az);
    return [x * c - y * s, x * s + y * c, z];
  };
  const proy = ([x, y, z]) => { // → [x, y, profundidad 0 (detrás) … 1 (delante), escala]
    let c = Math.cos(yaw), s = Math.sin(yaw);
    const x1 = x * c - z * s, z1 = x * s + z * c;
    c = Math.cos(pitch); s = Math.sin(pitch);
    const y1 = y * c - z1 * s, z2 = y * s + z1 * c;
    const f = 7 / (7 - z2);
    return [W / 2 + x1 * f * S, H / 2 + y1 * f * S, Math.max(0, Math.min(1, (z2 + 1.1) / 2.2)), f];
  };

  const medir = () => {
    if (MODO === "nucleo") {
      const vc = root.closest(".view-content") || root.parentElement;
      const otros = root.offsetHeight - caja.offsetHeight;
      caja.style.height = `${Math.max(380, vc.clientHeight - otros - 40)}px`;
    }
    W = caja.clientWidth; H = caja.clientHeight; dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = `${W}px`; canvas.style.height = `${H}px`;
    S = Math.min(W / 6.2, H / 3.6) * zoom();
  };
  const ro = new ResizeObserver(medir);
  ro.observe(caja);
  const vc = root.closest(".view-content");
  if (vc) ro.observe(vc);

  // Polilínea 3D en dos pasadas (detrás tenue, delante intensa) para no partirla en mil trazos
  const trazo = (pts, color, ancho, aDetras, aDelante, brillo, saltar) => {
    const P = pts.map(proy);
    for (const delante of [false, true]) {
      ctx.beginPath();
      for (let i = 1; i < P.length; i++) {
        if (saltar && saltar[i % saltar.length]) continue;
        const a = P[i - 1], b = P[i];
        if ((a[2] + b[2] > 1) !== delante) continue;
        ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]);
      }
      ctx.globalAlpha = delante ? aDelante : aDetras;
      ctx.strokeStyle = color; ctx.lineWidth = ancho;
      ctx.shadowColor = color; ctx.shadowBlur = delante ? brillo : 0;
      ctx.stroke();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };

  // ---------- Lunas ----------
  const giraY = ([x, y, z], a) => { const c = Math.cos(a), s = Math.sin(a); return [x * c - z * s, y, x * s + z * c]; };
  const centroLuna = (m, t) => {
    const a = m.fase + t * m.vel;
    return rotar([Math.cos(a) * m.a, 0, Math.sin(a) * m.b], m.incX, m.incZ);
  };
  const enLuna = (m, q, t) => { // punto local (radio 1) → mundo
    const l = giraY(q, t * m.giro);
    return [m.c[0] + l[0] * R_LUNA, m.c[1] + l[1] * R_LUNA, m.c[2] + l[2] * R_LUNA];
  };
  const retLuna = [];
  for (let mm = 0; mm < 4; mm++) {
    const lon = (mm / 4) * Math.PI, pts = [];
    for (let i = 0; i <= 40; i++) { const lat = (i / 40) * Math.PI * 2; pts.push([Math.cos(lat) * Math.cos(lon), Math.sin(lat), Math.cos(lat) * Math.sin(lon)]); }
    retLuna.push(pts);
  }
  for (const lat of [-0.5, 0, 0.5]) {
    const pts = [], r = Math.cos(lat), y = Math.sin(lat);
    for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; pts.push([Math.cos(a) * r, y, Math.sin(a) * r]); }
    retLuna.push(pts);
  }
  const dibujarOrbitas = () => {
    ctx.setLineDash([3, 6]);
    for (const m of lunas) {
      const pts = [];
      for (let i = 0; i <= 120; i++) { const a = (i / 120) * Math.PI * 2; pts.push(rotar([Math.cos(a) * m.a, 0, Math.sin(a) * m.b], m.incX, m.incZ)); }
      trazo(pts, m.color, 0.8, 0.07, 0.25, 0);
    }
    ctx.setLineDash([]);
  };
  // Haz de datos luna ↔ planeta: línea con pulsos que suben a la máquina (color de la asignatura) y bajan (cian)
  const dibujarHaz = (m) => {
    const len = Math.hypot(...m.c), dir = m.c.map((v) => v / len);
    const ini = dir.map((v) => v * 1.02), fin = dir.map((v) => v * (len - R_LUNA * 1.05));
    const pts = Array.from({ length: 13 }, (_, i) => ini.map((v, j) => v + (fin[j] - v) * (i / 12)));
    trazo(pts, m.color, 2.4, 0.12, 0.35, 10);
    trazo(pts, "#ffffff", 0.6, 0.15, 0.5, 0);
    for (const q of m.pulsos) {
      q.u = (q.u + 0.006) % 1;
      const p = proy(fin.map((v, j) => v + (ini[j] - v) * (q.sube ? q.u : 1 - q.u)));
      ctx.globalAlpha = 0.35 + 0.65 * p[2];
      ctx.fillStyle = q.sube ? m.color : "#cdf6ff";
      ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 10;
      ctx.beginPath(); ctx.arc(p[0], p[1], 2.2 * p[3], 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };
  const dibujarLuna = (m, t) => {
    const [cx, cy, cz, cf] = proy(m.c), rr = R_LUNA * S * cf;
    const g = ctx.createRadialGradient(cx, cy, rr * 0.2, cx, cy, rr * 2.2);
    g.addColorStop(0, m.color + "33"); g.addColorStop(0.45, m.color + "14"); g.addColorStop(1, m.color + "00");
    ctx.fillStyle = g; ctx.globalAlpha = 0.5 + 0.5 * cz;
    ctx.beginPath(); ctx.arc(cx, cy, rr * 2.2, 0, Math.PI * 2); ctx.fill();
    ctx.globalAlpha = 1;
    for (const pts of retLuna) trazo(pts.map((q) => enLuna(m, q, t)), m.color, 0.7, 0.08, 0.3, 4);
    ctx.globalAlpha = 0.25 + 0.5 * cz; ctx.strokeStyle = m.color; ctx.lineWidth = 1.2;
    ctx.shadowColor = m.color; ctx.shadowBlur = 12;
    ctx.beginPath(); ctx.arc(cx, cy, rr, 0, Math.PI * 2); ctx.stroke();
    // anillo con el progreso de la asignatura
    ctx.lineWidth = 2.4; ctx.globalAlpha = 0.6 + 0.4 * cz;
    ctx.beginPath(); ctx.arc(cx, cy, rr + 6, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (m.pct / 100)); ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.fillStyle = m.color;
    for (const q of m.polvo) {
      const p = proy(enLuna(m, q, t));
      ctx.globalAlpha = 0.06 + 0.4 * p[2] * p[2];
      ctx.fillRect(p[0] - 0.6, p[1] - 0.6, 1.2, 1.2);
    }
    ctx.globalAlpha = 0.55 + 0.45 * cz;
    ctx.font = "bold 12px Orbitron, 'Share Tech Mono', monospace"; ctx.textAlign = "center";
    ctx.fillStyle = m.color; ctx.shadowColor = m.color; ctx.shadowBlur = 8;
    ctx.fillText(`${m.k} · ${m.pct}%`, cx, cy - rr - 14);
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  };

  const dibujar = () => {
    const t = performance.now() / 1000;
    for (const m of lunas) m.c = centroLuna(m, t);
    const detras = lunas.filter((m) => proy(m.c)[2] < 0.5), delante = lunas.filter((m) => !detras.includes(m));
    if (!arrastre && !hover) yaw += 0.0025;
    const lado = Math.round(S * 0.62);
    if (lado !== ladoReactor) { ladoReactor = lado; capa.style.width = capa.style.height = `${lado}px`; }

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    const g = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, S * 1.6);
    g.addColorStop(0, "rgba(62,232,255,.10)"); g.addColorStop(1, "rgba(62,232,255,0)");
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    dibujarOrbitas();
    for (const m of detras) { dibujarHaz(m); dibujarLuna(m, t); }
    // Retícula
    for (const pts of reticula) trazo(pts, "#3ee8ff", 0.7, 0.04, 0.12, 0);
    // Rayos de datos (con un pulso que sale hacia fuera)
    ctx.setLineDash([2, 3]);
    for (const delante of [false, true]) {
      ctx.beginPath();
      for (const r of rayos) {
        const a = proy(r.d.map((v) => v * r.ini)), b = proy(r.d.map((v) => v * r.fin));
        if ((a[2] > 0.5) !== delante) continue;
        ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]);
      }
      ctx.globalAlpha = delante ? 0.55 : 0.15; ctx.strokeStyle = "#3ee8ff"; ctx.lineWidth = 1.2; ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.fillStyle = "#cdf6ff";
    for (const r of rayos) {
      const u = (t * 0.35 + r.fase) % 1, k = r.ini + (r.fin - r.ini) * u;
      const p = proy(r.d.map((v) => v * k));
      ctx.globalAlpha = (1 - u) * (0.2 + 0.8 * p[2]);
      ctx.fillRect(p[0] - 1, p[1] - 1, 2, 2);
    }
    // Partículas
    for (const q of polvo) {
      const p = proy(q);
      ctx.globalAlpha = 0.08 + 0.5 * p[2] * p[2];
      ctx.fillStyle = "#3ee8ff";
      ctx.fillRect(p[0] - 0.7, p[1] - 0.7, 1.4 * p[3], 1.4 * p[3]);
    }
    ctx.globalAlpha = 1;
    // Anillos orbitales
    for (const a of anillos) {
      const giro = a.fase + t * a.vel, pts = [];
      for (let i = 0; i <= 96; i++) {
        const ang = giro + (i / 96) * Math.PI * 2;
        pts.push(rotar([Math.cos(ang) * a.rad, 0, Math.sin(ang) * a.rad], a.incX, a.incZ));
      }
      if (a.tipo === "luz") trazo(pts, a.color, 2.2, 0.18, 0.9, 14);
      else if (a.tipo === "datos") trazo(pts, a.color, 4, 0.1, 0.55, 6, a.huecos);
      else trazo(pts, a.color, 0.8, 0.08, 0.35, 0);
    }
    for (const m of delante) { dibujarHaz(m); dibujarLuna(m, t); }

    // Proyección de las notas
    for (const n of lista) [n.sx, n.sy, n.z, n.f] = proy(n.luna ? enLuna(lunaDe[n.luna], n.p, t) : n.p);
    const resaltados = hover ? new Set([hover, ...hover.vecinos]) : null;
    // Filamentos (enlaces) atravesando la esfera
    for (const [a, b] of aristas) {
      const on = hover && (a === hover || b === hover);
      const prof = (a.z + b.z) / 2;
      ctx.globalAlpha = on ? 0.95 : resaltados ? 0.04 : 0.08 + 0.3 * prof;
      ctx.strokeStyle = on ? "#ffffff" : a.color; ctx.lineWidth = on ? 1.4 : 0.8;
      ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
    }
    // Paquetes de datos por los enlaces
    if (aristas.length && Math.random() < 0.2 && paquetes.length < 24) {
      const e = aristas[Math.floor(Math.random() * aristas.length)];
      paquetes.push({ e: Math.random() < 0.5 ? e : [e[1], e[0]], t: 0 });
    }
    ctx.fillStyle = "rgba(220,255,255,.95)"; ctx.shadowColor = "#3ee8ff"; ctx.shadowBlur = 8;
    for (let i = paquetes.length - 1; i >= 0; i--) {
      const p = paquetes[i];
      p.t += 0.015;
      if (p.t >= 1) { paquetes.splice(i, 1); continue; }
      const [a, b] = p.e;
      ctx.globalAlpha = 0.3 + 0.7 * ((a.z + b.z) / 2);
      ctx.beginPath(); ctx.arc(a.sx + (b.sx - a.sx) * p.t, a.sy + (b.sy - a.sy) * p.t, 1.6, 0, Math.PI * 2); ctx.fill();
    }
    // Nodos, de atrás hacia delante
    for (const n of [...lista].sort((a, b) => a.z - b.z)) {
      const tenue = resaltados && !resaltados.has(n);
      ctx.globalAlpha = tenue ? 0.12 : 0.25 + 0.75 * n.z;
      const r = n.r * n.f;
      ctx.shadowColor = n.color; ctx.shadowBlur = n === hover ? 24 : 6 + 10 * n.z;
      ctx.fillStyle = n.ext === "md" ? n.color : "rgba(127,169,184,.8)";
      ctx.beginPath(); ctx.arc(n.sx, n.sy, r, 0, Math.PI * 2); ctx.fill();
      if (n.estado) { // anillo con el estado del tema
        ctx.shadowBlur = 0; ctx.strokeStyle = n.color; ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.arc(n.sx, n.sy, r + 3.5, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (PESO[n.estado] ?? 0)); ctx.stroke();
      }
    }
    // Etiquetas: las notas de delante con más enlaces o con estado, y las del nodo señalado
    ctx.shadowBlur = 0;
    ctx.font = "11px 'Share Tech Mono', Consolas, monospace";
    ctx.textAlign = "center";
    for (const n of lista) {
      const ver = resaltados ? resaltados.has(n) : n.z > 0.6 && n.ext === "md" && (n.vecinos.size >= 3 || n.estado);
      if (!ver) continue;
      ctx.globalAlpha = resaltados ? 1 : Math.min(1, (n.z - 0.6) * 3);
      ctx.fillStyle = n === hover ? "#ffffff" : "rgba(205,246,255,.8)";
      const txt = n.nombre.length > 30 ? n.nombre.slice(0, 29) + "…" : n.nombre;
      ctx.fillText(txt, n.sx, n.sy + n.r * n.f + 13);
    }
    ctx.globalAlpha = 1;
  };

  const bucle = () => {
    if (!root.isConnected) { ro.disconnect(); return; }
    if (W && H) dibujar();
    requestAnimationFrame(bucle);
  };

  // Ratón: señalar, abrir y arrastrar para girar
  canvas.addEventListener("mousedown", (e) => { arrastre = { x: e.clientX, y: e.clientY, movido: 0 }; });
  canvas.addEventListener("mouseup", () => { setTimeout(() => { arrastre = null; }, 0); });
  canvas.addEventListener("mousemove", (e) => {
    if (arrastre && e.buttons) {
      const dx = e.clientX - arrastre.x, dy = e.clientY - arrastre.y;
      arrastre.movido += Math.abs(dx) + Math.abs(dy);
      arrastre.x = e.clientX; arrastre.y = e.clientY;
      yaw += dx * 0.008;
      pitch = Math.max(-1.3, Math.min(1.3, pitch + dy * 0.008));
      canvas.style.cursor = "grabbing";
      return;
    }
    const r = canvas.getBoundingClientRect();
    const mx = e.clientX - r.left, my = e.clientY - r.top;
    let mejor = null, dmin = Infinity;
    for (const n of lista) {
      if (n.z < 0.4) continue; // solo los de la cara visible
      const d = Math.hypot(n.sx - mx, n.sy - my);
      if (d < Math.max(8, n.r * n.f + 4) && d < dmin) { mejor = n; dmin = d; }
    }
    if (mejor !== hover) {
      hover = mejor;
      info.setText(hover
        ? `▸ ${hover.nombre}${hover.ext !== "md" ? "." + hover.ext : ""} · ${hover.carpeta || "raíz"} · ENLACES ${hover.vecinos.size}${hover.estado ? " · ESTADO " + hover.estado.toUpperCase() : ""}`
        : infoBase);
    }
    canvas.style.cursor = hover ? "pointer" : "grab";
  });
  canvas.addEventListener("mouseleave", () => { hover = null; arrastre = null; info.setText(infoBase); });
  bMas.onclick = () => ponerZoom(zoom() * 1.2);
  bMenos.onclick = () => ponerZoom(zoom() / 1.2);
  bReset.onclick = () => ponerZoom(1);
  canvas.addEventListener("wheel", (e) => { e.preventDefault(); ponerZoom(zoom() * (e.deltaY < 0 ? 1.1 : 1 / 1.1)); }, { passive: false });
  // Ctrl + / − / 0 solo cuando el ratón está sobre el núcleo (fuera de él, Obsidian hace su zoom normal)
  let dentro = false;
  caja.addEventListener("mouseenter", () => { dentro = true; });
  caja.addEventListener("mouseleave", () => { dentro = false; });
  const teclas = (e) => {
    if (!root.isConnected) { window.removeEventListener("keydown", teclas, true); return; }
    if (!dentro || !(e.ctrlKey || e.metaKey)) return;
    const k = e.key;
    if (k === "+" || k === "=" || k === "Add") ponerZoom(zoom() * 1.2);
    else if (k === "-" || k === "Subtract") ponerZoom(zoom() / 1.2);
    else if (k === "0") ponerZoom(1);
    else return;
    e.preventDefault(); e.stopPropagation();
  };
  window.addEventListener("keydown", teclas, true);
  ponerZoom(zoom());
  canvas.addEventListener("click", (e) => {
    if (arrastre && arrastre.movido > 4) return; // era un arrastre, no un clic
    if (hover) abrir(hover.path, e.ctrlKey || e.metaKey);
  });

  setTimeout(() => { medir(); bucle(); }, 30);
};

// ---------- UNIVERSO AARON › GALAXIA UNED ----------
// Arquitectura (ver AARON/CLAUDE.md): en el centro, AARON (agujero negro: el humano que decide; guarda la
// memoria y las decisiones, carpeta AARON/) y JARVIS (el agente, que orbita a AARON). Alrededor, la galaxia
// UNED: un sistema solar por año y planetas = asignaturas; las naves son relaciones entre asignaturas.
// Por ahora solo existe la galaxia UNED; el código está pensado para que en el futuro haya otras.
// ---------- Galaxia: la máquina en el centro, un sistema solar por año, planetas = asignaturas ----------
// Núcleo galáctico = la máquina (JARVIS): las notas que no son de ninguna asignatura (planificación, red
// neuronal, memoria, libros…) sobre una esfera con el reactor dentro. Alrededor gira un disco de brazos
// espirales. Cada año del grado es un sistema solar: su sol orbita el núcleo y está unido a él por un haz de
// datos; sus planetas son las asignaturas (órbitas interiores = 1.er cuatrimestre, exteriores = 2.º), cada uno
// con sus notas, su anillo de progreso y su giro propio. Los años sin asignaturas aparecen como soles apagados.
// Clic en un sol → se acerca a ese sistema; botones ◎ (galaxia) y ⬤ (núcleo); zoom con + − ⟲, rueda y Ctrl +/−/0.
// La vista anterior (planeta + 3 lunas) sigue en modGrafo: para volver a ella basta montar modGrafo en vez de esta.
const modGalaxia = (parent) => {
  const caja = el(parent, "div", "jv-graph jv-galaxia");
  const canvas = el(caja, "canvas");
  const capa = el(caja, "div", "jv-graph-reactor");
  capa.innerHTML = svgReactor(false);
  animarAnillos(capa);
  const info = el(caja, "div", "jv-graph-info");
  const menu = el(caja, "nav", "jv-nav"); // menú de navegación: se rellena más abajo (montarMenu)
  // Mandos: zoom y vistas
  const mandos = el(caja, "div", "jv-zoom");
  const bMas = el(mandos, "button", "jv-zoom-b", "+");
  const zTxt = el(mandos, "span", "jv-zoom-v");
  const bMenos = el(mandos, "button", "jv-zoom-b", "−");
  const bReset = el(mandos, "button", "jv-zoom-b jv-zoom-r", "⟲");
  const bGal = el(mandos, "button", "jv-zoom-b jv-zoom-r", "◎");
  const bNuc = el(mandos, "button", "jv-zoom-b", "⬤");
  bMas.title = "Acercar (Ctrl +)"; bMenos.title = "Alejar (Ctrl −)"; bReset.title = "Zoom normal de esta vista (Ctrl 0)";
  bGal.title = "Ver la galaxia entera"; bNuc.title = "Ir al centro: AARON y JARVIS";

  // ---------- Notas y enlaces ----------
  const estadoDe = new Map(temas.array().map((p) => [p.file.path, p.estado]));
  // asignaturas de la galaxia: las que están en curso (CFG.asig) y el resto del plan (CFG.plan, "por cursar")
  const gal = {};
  for (const k of claves) gal[k] = { ...CFG.asig[k], k, activa: true };
  for (const x of CFG.plan || []) if (!gal[x.k]) gal[x.k] = { ...x, activa: false };
  const galK = Object.keys(gal);
  const asigDeRuta = (path) => galK.find((k) => path.startsWith(gal[k].carpeta + "/"));
  const colorDe = (path) => {
    const k = asigDeRuta(path);
    if (k) return gal[k].color;
    const top = path.includes("/") ? path.split("/")[0] : "";
    return CFG.otrasCarpetas[top] || "#7fa9b8";
  };
  const nodos = new Map();
  const add = (path) => {
    if (path.startsWith("PLANIFICACION/Jarvis/") || path.startsWith("ARCHIVO/")) return null;
    if (!nodos.has(path)) {
      const f = app.vault.getAbstractFileByPath(path);
      if (!f) return null;
      nodos.set(path, {
        path, nombre: f.basename, ext: f.extension, carpeta: f.parent ? f.parent.path : "",
        color: colorDe(path), estado: estadoDe.get(path), vecinos: new Set(), cuerpo: path.startsWith("AARON/") ? "AARON" : asigDeRuta(path) || null,
      });
    }
    return nodos.get(path);
  };
  for (const f of app.vault.getMarkdownFiles()) add(f.path);
  const aristas = [];
  for (const [src, dsts] of Object.entries(app.metadataCache.resolvedLinks)) {
    const a = add(src);
    if (!a) continue;
    for (const dst of Object.keys(dsts)) {
      const b = dst !== src ? add(dst) : null;
      if (!b || a.vecinos.has(b)) continue;
      a.vecinos.add(b); b.vecinos.add(a);
      aristas.push([a, b]);
    }
  }
  const lista = [...nodos.values()].sort((a, b) => a.path.localeCompare(b.path));

  // ---------- Geometría (unidades: radio del núcleo = 1) ----------
  let sem = 11;
  const rnd = () => (sem = (sem * 16807) % 2147483647) / 2147483647;
  const fib = (i, n) => {
    const y = 1 - (2 * (i + 0.5)) / n, r = Math.sqrt(1 - y * y), th = i * Math.PI * (3 - Math.sqrt(5));
    return [Math.cos(th) * r, y, Math.sin(th) * r];
  };
  const rotar = ([x, y, z], ax, az) => {
    let c = Math.cos(ax), s = Math.sin(ax);
    [y, z] = [y * c - z * s, y * s + z * c];
    c = Math.cos(az); s = Math.sin(az);
    return [x * c - y * s, x * s + y * c, z];
  };
  const giraY = ([x, y, z], a) => { const c = Math.cos(a), s = Math.sin(a); return [x * c - z * s, y, x * s + z * c]; };
  const suma = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];

  // Sistemas solares: uno por año, a lo largo de un brazo espiral
  const R_SOL = 0.42, R_PLANETA = 0.2;
  // Un color por año: oro, coral, rosa, azul, menta y violeta
  const COLORES_SOL = ["#ffd36e", "#ff8a65", "#ff6fae", "#7fd4ff", "#7dffc4", "#c49bff"];
  const aclarar = (hex, k) => { // mezcla con blanco
    const n = parseInt(hex.slice(1), 16), c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.round(v + (255 - v) * k));
    return "#" + c.map((v) => v.toString(16).padStart(2, "0")).join("");
  };
  const anios = Array.from({ length: CFG.anios }, (_, i) => {
    const a = i + 1, R = 8.6 + i * 5.6; // separación suficiente para sistemas de hasta 6 planetas
    const asigs = galK.filter((k) => (gal[k].anio ?? 1) === a);
    const cuatri = (c) => asigs.filter((k) => (gal[k].cuatri ?? 1) === c);
    const planetas = [];
    for (const c of [1, 2]) cuatri(c).forEach((k, j) => {
      const r = (c === 1 ? 0.95 : 2.15) + j * 0.36;
      planetas.push({
        k, cuatri: c, color: gal[k].color, nombre: gal[k].nombre, activa: gal[k].activa,
        pct: gal[k].activa ? progreso.find((x) => x.k === k).pct : 0, r,
        vel: 0.9 / Math.pow(r, 1.5), fase: rnd() * 6.3, incX: (rnd() - 0.5) * 0.35, incZ: (rnd() - 0.5) * 0.35,
        giro: 0.5 + rnd() * 0.4, polvo: Array.from({ length: 70 }, (_, q) => fib(q, 70)),
      });
    });
    return {
      a, R, th0: 0.5 + i * 1.32, vel: 0.05 / Math.sqrt(R), color: COLORES_SOL[i % COLORES_SOL.length],
      activo: asigs.length > 0, enCurso: asigs.some((k) => gal[k].activa), planetas, radio: planetas.length ? Math.max(...planetas.map((p) => p.r)) + 0.4 : 1.2,
      pulsos: Array.from({ length: 8 }, (_, j) => ({ u: j / 8, sube: j % 2 === 0 })),
      anillos: ["luz", "datos", "fino"].map((tipo) => ({
        tipo, rad: 1.25 + rnd() * 0.35, incX: (rnd() - 0.5) * 2.4, incZ: (rnd() - 0.5) * 2.4,
        vel: (rnd() < 0.5 ? -1 : 1) * (0.1 + rnd() * 0.25), fase: rnd() * 6.3,
        huecos: Array.from({ length: 60 }, () => rnd() < (tipo === "datos" ? 0.45 : 0.08)),
      })),
    };
  });
  const planetaDe = {};
  for (const s of anios) for (const p of s.planetas) { p.sol = s; planetaDe[p.k] = p; }

  // Notas del núcleo y de cada planeta, repartidas sobre su esfera (radio 1)
  const repartir = (ns) => ns.forEach((n, i) => {
    const [x, y, z] = fib(i, ns.length), k = 0.97 + rnd() * 0.06;
    n.p = [x * k, y * k, z * k];
  });
  repartir(lista.filter((n) => !n.cuerpo));
  // AARON: agujero negro en el origen. Sus notas (memoria, red neuronal, perfil…) orbitan en el disco de acreción.
  const R_BH = 0.62, DISCO = [0.95, 2.05], INC_DISCO = 0.28;
  const enDisco = (q) => rotar(q, INC_DISCO, 0.08);
  const notasAaron = lista.filter((n) => n.cuerpo === "AARON");
  notasAaron.forEach((n, i) => { n.orb = { r: DISCO[0] + 0.1 + (i / Math.max(1, notasAaron.length - 1)) * (DISCO[1] - DISCO[0] - 0.2), a0: i * 2.4 }; });
  const discoP = Array.from({ length: 1100 }, () => {
    const r = DISCO[0] + Math.pow(rnd(), 1.6) * (DISCO[1] - DISCO[0]);
    const u = (r - DISCO[0]) / (DISCO[1] - DISCO[0]);
    return { r, a0: rnd() * 6.3, h: (rnd() - 0.5) * 0.05, c: u < 0.15 ? "#fff4e0" : u < 0.45 ? "#ffb070" : u < 0.75 ? "#ff6fae" : "#a77bff", t: rnd() };
  });
  const caida = Array.from({ length: 36 }, () => ({ u: rnd(), a0: rnd() * 6.3, r0: 2.4 + rnd() * 1.6, v: 0.05 + rnd() * 0.06 }));
  // JARVIS: el agente orbita a AARON
  const D_J = 3.4;
  const jarvisPos = (t) => { const a = 0.4 + t * 0.035; return [Math.cos(a) * D_J, Math.sin(a * 2) * 0.15, Math.sin(a) * D_J]; };
  let J = jarvisPos(performance.now() / 1000);
  const enJ = (q) => suma(J, q);
  for (const k of galK) repartir(lista.filter((n) => n.cuerpo === k));
  lista.forEach((n) => {
    n.r = (n.ext === "md" ? 3.2 : 2.2) + Math.min(5, Math.sqrt(n.vecinos.size) * 1.3) + (n.estado ? 1.5 : 0);
