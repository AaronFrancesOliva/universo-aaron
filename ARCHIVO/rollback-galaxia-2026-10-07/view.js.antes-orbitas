        ctx.setLineDash(d); ctx.globalAlpha = 0.28;
        ctx.beginPath(); ctx.ellipse(cx, cy, rh * k, rh * k * 0.5, 0, t * v, t * v + Math.PI * 2); ctx.stroke();
      });
      ctx.setLineDash([]); ctx.globalAlpha = 1;
