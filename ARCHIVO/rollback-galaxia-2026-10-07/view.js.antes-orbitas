    for (const a of anillosN) {
      const giro = a.fase + t * a.vel, pts = [];
      for (let i = 0; i <= 72; i++) { const ang = giro + (i / 72) * Math.PI * 2; pts.push(enJ(rotar([Math.cos(ang) * a.rad, 0, Math.sin(ang) * a.rad], a.incX, a.incZ))); }
      if (a.tipo === "luz") trazo(pts, "#3ee8ff", 2, 0.15, 0.8, 12, null, J, 1.4);
      else if (a.tipo === "datos") trazo(pts, "#4dffb5", 3.5, 0.1, 0.5, 6, a.huecos, J, 1.4);
      else trazo(pts, "#3ee8ff", 0.8, 0.08, 0.35, 0, null, J, 1.4);
    }
    etiqueta("JARVIS", cx, cy - rr * 1.55 - 6, "#e8fbff", 0.85, rr > 50 ? 13 : 10);
