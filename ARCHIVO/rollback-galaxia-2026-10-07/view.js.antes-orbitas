      ctx.globalAlpha = 1;
      etiqueta(p.k, cx, cy - rr - 8, p.color, 0.55, rr > 14 ? 11 : 9);
      p.sx = cx; p.sy = cy; p.sr = rr;
      return;
    }
    halo(cx, cy, rr * 2.6, p.color, 0.55);
    if (rr > 9) for (const pts of retPeq) trazo(pts.map((q) => enPlaneta(p, q, t)), p.color, 0.6, 0.06, 0.3, 3, null, p.c, R_PLANETA);
    ctx.strokeStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10;
    ctx.globalAlpha = 0.5 + 0.4 * cz; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.arc(cx, cy, rr, 0, Math.PI * 2); ctx.stroke();
    ctx.lineWidth = 2.2; ctx.globalAlpha = 0.85;
    ctx.beginPath(); ctx.arc(cx, cy, rr + 4, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (p.pct / 100)); ctx.stroke();
    ctx.shadowBlur = 0; ctx.fillStyle = p.color;
    if (rr > 6) for (const q of p.polvo) {
      const s = proy(enPlaneta(p, q, t), p.c, R_PLANETA);
      ctx.globalAlpha = 0.06 + 0.4 * s[2] * s[2];
      ctx.fillRect(s[0] - 0.6, s[1] - 0.6, 1.2, 1.2);
    }
    etiqueta(`${p.k} · ${p.pct}%`, cx, cy - rr - 10, p.color, 0.9, rr > 14 ? 12 : 10);
    p.sx = cx; p.sy = cy; p.sr = rr;
  };
  const dibujarSistema = (s, t) => {
    const [cx, cy, , cf] = proy(s.c, s.c, s.radio), rr = Math.max(3, R_SOL * S * cf);
    // órbitas: 1.er cuatrimestre continuas, zona del 2.º punteada
    for (const p of s.planetas) {
      const pts = Array.from({ length: 97 }, (_, i) => { const a = (i / 96) * Math.PI * 2; return suma(s.c, rotar([Math.cos(a) * p.r, 0, Math.sin(a) * p.r], p.incX, p.incZ)); });
      trazo(pts, p.color, 0.8, 0.1, 0.3, 0, null, s.c, p.r);
    }
    ctx.setLineDash([2, 7]);
    for (const r of [0.95, 2.15]) trazo(circulo(s.c, r - 0.2), s.color, 0.6, 0.05, s.activo ? 0.14 : 0.08, 0, null, s.c, r);
    ctx.setLineDash([]);
    // sol: misma estética que el núcleo (retícula, polvo, anillos de datos y reactor), en dorado
    const k = s.enCurso ? 1 : s.activo ? 0.6 : 0.4; // el año en curso brilla; los futuros, más apagados
    const enSol = (q) => suma(s.c, q, R_SOL);
    halo(cx, cy, rr * (s.activo ? 4.2 : 2.6), s.color, 0.7 * k);
    if (rr > 6) {
      for (const pts of rr > 40 ? reticula : retPeq) trazo(pts.map(enSol), s.color, 0.7, 0.05 * k, 0.2 * k, 0, null, s.c, R_SOL);
      ctx.fillStyle = s.color;
      for (let i = 0; i < polvoN.length; i += rr > 40 ? 1 : 3) {
        const q = proy(enSol(polvoN[i]), s.c, R_SOL);
        ctx.globalAlpha = (0.06 + 0.45 * q[2] * q[2]) * k;
        ctx.fillRect(q[0] - 0.7, q[1] - 0.7, 1.4, 1.4);
      }
      for (const a of s.anillos) {
        const giro = a.fase + t * a.vel, pts = [];
        for (let i = 0; i <= 60; i++) { const ang = giro + (i / 60) * Math.PI * 2; pts.push(enSol(rotar([Math.cos(ang) * a.rad, 0, Math.sin(ang) * a.rad], a.incX, a.incZ))); }
        const rad = a.rad * R_SOL;
        if (a.tipo === "luz") trazo(pts, s.color, 1.8, 0.15 * k, 0.8 * k, 12, null, s.c, rad);
        else if (a.tipo === "datos") trazo(pts, aclarar(s.color, 0.55), 3, 0.1 * k, 0.5 * k, 6, a.huecos, s.c, rad);
        else trazo(pts, s.color, 0.8, 0.08 * k, 0.35 * k, 0, null, s.c, rad);
      }
    }
    // reactor dorado en el centro (como el del núcleo, dibujado en el lienzo)
    const rc = rr * 0.62;
    ctx.globalAlpha = k;
    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rc);
    g.addColorStop(0, aclarar(s.color, 0.85)); g.addColorStop(0.35, s.color); g.addColorStop(1, s.color + "00");
    ctx.fillStyle = g; ctx.shadowColor = s.color; ctx.shadowBlur = s.activo ? 25 : 6;
    ctx.beginPath(); ctx.arc(cx, cy, rc, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 0;
    ctx.strokeStyle = s.color;
    [[0.95, 1.4, 0.35, [6, 4]], [0.75, 1, -0.6, [2, 3]], [0.55, 0.8, 0.9, []]].forEach(([f, w, v, dash]) => {
      ctx.setLineDash(dash); ctx.lineWidth = w; ctx.globalAlpha = 0.8 * k;
      ctx.beginPath(); ctx.arc(cx, cy, rc * f, t * v, t * v + Math.PI * 1.6); ctx.stroke();
    });
    ctx.setLineDash([]);
    for (let i = 0; i < 3; i++) { // tres segmentos tipo "arc reactor"
      const a = t * 0.8 + (i / 3) * Math.PI * 2;
      ctx.lineWidth = 2.2; ctx.globalAlpha = 0.9 * k;
      ctx.beginPath(); ctx.arc(cx, cy, rc * 1.15, a, a + 0.6); ctx.stroke();
    }
    ctx.globalAlpha = 1;
    const sub = s.enCurso ? `EN CURSO · ${s.planetas.length} ASIGNATURAS` : s.activo ? `${s.planetas.length} ASIGNATURA${s.planetas.length > 1 ? "S" : ""} POR CURSAR` : "POR EXPLORAR";
    etiqueta(`AÑO ${s.a}`, cx, cy + rr + 18, s.color, s.activo ? 0.95 : 0.5, 12);
    etiqueta(sub, cx, cy + rr + 31, s.color, s.activo ? 0.6 : 0.35, 9);
    s.sx = cx; s.sy = cy; s.sr = rr;
    // planetas: los de detrás del sol primero
    const ps = [...s.planetas].sort((a, b) => camZ(a.c)[2] - camZ(b.c)[2]);
    for (const p of ps) dibujarPlaneta(p, t);
  };

  // ---------- Bucle de dibujo ----------
  // ---------- Naves: relaciones entre asignaturas ----------
  const rutas = (CFG.relaciones || []).filter((r) => planetaDe[r.de] && planetaDe[r.a]).map((r) => ({
    ...r, naves: [{ sx: -99, sy: -99 }],
  }));
  const bezier = (a, c, b, u) => [0, 1, 2].map((j) => (1 - u) * (1 - u) * a[j] + 2 * (1 - u) * u * c[j] + u * u * b[j]);
  const dibujarNaves = (t) => {
    for (const r of rutas) {
      const A = planetaDe[r.de], B = planetaDe[r.a];
      const dist = Math.hypot(A.c[0] - B.c[0], A.c[1] - B.c[1], A.c[2] - B.c[2]);
      const ctrl = suma([(A.c[0] + B.c[0]) / 2, (A.c[1] + B.c[1]) / 2, (A.c[2] + B.c[2]) / 2], [0, 1, 0], dist * 0.45);
      const mid = ctrl;
      // solo la conexión: una línea curva entre los dos planetas, del color de uno al del otro
      const pts = Array.from({ length: 33 }, (_, i) => bezier(A.c, ctrl, B.c, i / 32));
      const P = pts.map((q) => proy(q, mid, dist));
      const g = ctx.createLinearGradient(P[0][0], P[0][1], P[32][0], P[32][1]);
      g.addColorStop(0, A.color); g.addColorStop(1, B.color);
      ctx.strokeStyle = g; ctx.shadowColor = "#e8fbff"; ctx.shadowBlur = 8;
      ctx.lineWidth = 1.4; ctx.globalAlpha = 0.55;
      ctx.beginPath(); ctx.moveTo(P[0][0], P[0][1]);
      for (const q of P.slice(1)) ctx.lineTo(q[0], q[1]);
      ctx.stroke();
      ctx.shadowBlur = 0; ctx.globalAlpha = 1;
      // punto para pasar el ratón: el centro de la curva
      const n = r.naves[0];
      n.sx = P[16][0]; n.sy = P[16][1]; n.r = r;
    }
  };

  const nCore = lista.filter((n) => !n.cuerpo).length;
  const nAaron = notasAaron.length;
  const activos = anios.filter((s) => s.activo).length;
  const infoBase = `UNIVERSO AARON › GALAXIA UNED · AARON ${nAaron} · JARVIS ${nCore} · AÑOS ACTIVOS ${activos}/${anios.length} · NODOS ${lista.length} · CLIC EN UN SOL PARA ACERCARTE · ARRASTRA PARA GIRAR`;
  info.setText(infoBase);
  const paquetes = [];

  const dibujar = () => {
    const t = performance.now() / 1000;
    if (!arrastre && !hover) yaw += 0.0012;
    J = jarvisPos(t);
    for (const s of anios) s.c = solPos(s, t);
    for (const s of anios) for (const p of s.planetas) p.c = planetaPos(p, t);
    // cámara: acercarse suavemente al foco y al zoom deseado
    const obj = objetivo(t), zObj = zoomDe(foco) * zoomExtra;
    for (let j = 0; j < 3; j++) F[j] += (obj[j] - F[j]) * 0.08;
    zoomAct += (zObj - zoomAct) * 0.08;
    S = (Math.min(W, H) / 2 / VIEW_R) * zoomAct;
    zTxt.setText(`${Math.round(zoomExtra * 100)}%`);

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    // disco galáctico
    const giroGal = t * 0.01;
    for (const e of estrellas) {
      const p = proy(giraY(e.p, giroGal), null, R_GAL);
      if (p[0] < -5 || p[0] > W + 5 || p[1] < -5 || p[1] > H + 5) continue;
      const tw = 0.6 + 0.4 * Math.sin(t * 1.5 + e.t * 20);
      ctx.globalAlpha = (0.15 + 0.45 * p[2]) * tw; ctx.fillStyle = e.c;
      const z = Math.min(2.2, 0.8 * p[3]);
      ctx.fillRect(p[0] - z / 2, p[1] - z / 2, z, z);
    }
    ctx.globalAlpha = 1;
    // haces AARON ↔ soles y AARON ↔ JARVIS
    for (const s of anios) dibujarHaz(s);
    dibujarVinculo(t);
    // cuerpos ordenados de atrás hacia delante (AARON, JARVIS y sistemas)
    const cuerpos = [
      { z: camZ(O)[2], f: () => { dibujarAgujero(t, 0); dibujarAgujero(t, 1); } },
      { z: camZ(J)[2], f: () => dibujarNucleo(t) },
      ...anios.map((s) => ({ z: camZ(s.c)[2], f: () => dibujarSistema(s, t) })),
    ];
    for (const c of cuerpos.sort((a, b) => a.z - b.z)) c.f();
    dibujarNaves(t);

    // reactor sobre JARVIS
    const [rx, ry, , rf] = proy(J, J);
    const lado = Math.round(S * rf * 0.62);
    capa.style.left = `${rx}px`; capa.style.top = `${ry}px`;
    capa.style.display = lado < 24 ? "none" : "";
    if (lado !== ladoReactor) { ladoReactor = lado; capa.style.width = capa.style.height = `${lado}px`; }

    // notas
    for (const n of lista) {
      if (n.cuerpo === "AARON") {
        [n.sx, n.sy, n.z, n.f] = proy(posDisco(n.orb.r, n.orb.a0, 0, t), O, DISCO[1]);
        n.vis = R_BH * S * n.f > 14;
      } else if (n.cuerpo) {
        const pl = planetaDe[n.cuerpo];
        [n.sx, n.sy, n.z, n.f] = proy(enPlaneta(pl, n.p, t), pl.c, R_PLANETA);
        n.vis = pl.sr > 10;
      } else {
        [n.sx, n.sy, n.z, n.f] = proy(enJ(n.p), J);
        n.vis = S * n.f > 35;
      }
    }
    const resaltados = hover ? new Set([hover, ...hover.vecinos]) : null;
    for (const [a, b] of aristas) {
      if (!a.vis && !b.vis && !(hover && (a === hover || b === hover))) continue;
      const on = hover && (a === hover || b === hover);
      ctx.globalAlpha = on ? 0.95 : resaltados ? 0.03 : a.cuerpo !== b.cuerpo ? 0.07 : 0.06 + 0.25 * ((a.z + b.z) / 2);
      ctx.strokeStyle = on ? "#ffffff" : a.color; ctx.lineWidth = on ? 1.3 : 0.7;
      ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
    }
    if (aristas.length && Math.random() < 0.2 && paquetes.length < 24) {
      const e = aristas[Math.floor(Math.random() * aristas.length)];
      paquetes.push({ e: Math.random() < 0.5 ? e : [e[1], e[0]], t: 0 });
    }
    ctx.fillStyle = "rgba(220,255,255,.95)"; ctx.shadowColor = "#3ee8ff"; ctx.shadowBlur = 8;
    for (let i = paquetes.length - 1; i >= 0; i--) {
      const p = paquetes[i];
      p.t += 0.015;
      if (p.t >= 1) { paquetes.splice(i, 1); continue; }
      const [a, b] = p.e;
      if (!a.vis && !b.vis) continue;
      ctx.globalAlpha = 0.3 + 0.6 * ((a.z + b.z) / 2);
      ctx.beginPath(); ctx.arc(a.sx + (b.sx - a.sx) * p.t, a.sy + (b.sy - a.sy) * p.t, 1.5, 0, Math.PI * 2); ctx.fill();
    }
    ctx.shadowBlur = 0;
    const escala = (n) => (n.cuerpo === "AARON" ? Math.min(1, (R_BH * S * n.f) / 45) : n.cuerpo ? Math.min(1, planetaDe[n.cuerpo].sr / 40) : Math.min(1.2, (S * n.f) / 110));
    for (const n of [...lista].filter((n) => n.vis).sort((a, b) => a.z - b.z)) {
      const tenue = resaltados && !resaltados.has(n);
      ctx.globalAlpha = tenue ? 0.12 : 0.25 + 0.75 * n.z;
      const r = Math.max(1.2, n.r * escala(n));
      ctx.shadowColor = n.color; ctx.shadowBlur = n === hover ? 22 : 4 + 8 * n.z;
      ctx.fillStyle = n.ext === "md" ? n.color : "rgba(127,169,184,.8)";
      ctx.beginPath(); ctx.arc(n.sx, n.sy, r, 0, Math.PI * 2); ctx.fill();
      if (n.estado) {
        ctx.shadowBlur = 0; ctx.strokeStyle = n.color; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.arc(n.sx, n.sy, r + 3, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (PESO[n.estado] ?? 0)); ctx.stroke();
      }
      n.rr = r;
    }
    ctx.shadowBlur = 0;
    ctx.font = "11px 'Share Tech Mono', Consolas, monospace"; ctx.textAlign = "center";
    for (const n of lista) {
      if (!n.vis) continue;
      const ver = resaltados ? resaltados.has(n) : n.z > 0.6 && n.ext === "md" && (n.vecinos.size >= 3 || n.estado) && n.rr > 2.5;
      if (!ver) continue;
      ctx.globalAlpha = resaltados ? 1 : Math.min(1, (n.z - 0.6) * 3);
      ctx.fillStyle = n === hover ? "#ffffff" : "rgba(205,246,255,.8)";
      const txt = n.nombre.length > 30 ? n.nombre.slice(0, 29) + "…" : n.nombre;
      ctx.fillText(txt, n.sx, n.sy + n.rr + 12);
    }
    ctx.globalAlpha = 1;
  };

  const bucle = () => {
    if (!root.isConnected) { ro.disconnect(); return; }
    if (W && H) dibujar();
    requestAnimationFrame(bucle);
  };

  // ---------- Interacción ----------
  const irA = (f) => { foco = f; window.jvFoco = f; zoomExtra = 1; window.jvZoomExtra = 1; };
  const ponerZoom = (z) => { zoomExtra = Math.max(0.3, Math.min(4, Math.round(z * 100) / 100)); window.jvZoomExtra = zoomExtra; };
  bMas.onclick = () => ponerZoom(zoomExtra * 1.25);
  bMenos.onclick = () => ponerZoom(zoomExtra / 1.25);
  bReset.onclick = () => ponerZoom(1);
  bGal.onclick = () => irA({ tipo: "galaxia" });
  bNuc.onclick = () => irA({ tipo: "centro" });
  let solHover = null;
  canvas.addEventListener("mousedown", (e) => { arrastre = { x: e.clientX, y: e.clientY, movido: 0 }; });
  canvas.addEventListener("mouseup", () => { setTimeout(() => { arrastre = null; }, 0); });
  canvas.addEventListener("mousemove", (e) => {
    if (arrastre && e.buttons) {
      const dx = e.clientX - arrastre.x, dy = e.clientY - arrastre.y;
      arrastre.movido += Math.abs(dx) + Math.abs(dy);
      arrastre.x = e.clientX; arrastre.y = e.clientY;
      yaw += dx * 0.008;
      pitch = Math.max(-1.45, Math.min(1.45, pitch + dy * 0.008));
      canvas.style.cursor = "grabbing";
      return;
    }
    const r = canvas.getBoundingClientRect();
    const mx = e.clientX - r.left, my = e.clientY - r.top;
    let mejor = null, dmin = Infinity;
    for (const n of lista) {
      if (!n.vis || n.z < 0.4) continue;
      const d = Math.hypot(n.sx - mx, n.sy - my);
      if (d < Math.max(7, (n.rr || 2) + 4) && d < dmin) { mejor = n; dmin = d; }
    }
    solHover = null;
    if (!mejor) for (const s of anios) if (s.sx != null && Math.hypot(s.sx - mx, s.sy - my) < Math.max(12, s.sr + 6)) solHover = s;
    let nave = null;
    if (!mejor && !solHover) for (const r of rutas) for (const n of r.naves) if (Math.hypot(n.sx - mx, n.sy - my) < 10) nave = n;
    if (nave) { info.setText(`⇄ ${nave.r.de} ⇄ ${nave.r.a} · ${nave.r.tema}`); canvas.style.cursor = "help"; hover = null; return; }
    if (mejor !== hover || !mejor) {
      hover = mejor;
      info.setText(hover
        ? `▸ ${hover.nombre}${hover.ext !== "md" ? "." + hover.ext : ""} · ${hover.carpeta || "raíz"} · ENLACES ${hover.vecinos.size}${hover.estado ? " · ESTADO " + hover.estado.toUpperCase() : ""}`
        : solHover ? `☀ AÑO ${solHover.a} · ${solHover.activo ? solHover.planetas.map((p) => p.k).join(", ") + (solHover.enCurso ? " · EN CURSO" : " · POR CURSAR") : "sin asignaturas todavía"} · CLIC PARA ACERCARTE`
          : infoBase);
    }
    canvas.style.cursor = hover || solHover ? "pointer" : "grab";
  });
  canvas.addEventListener("mouseleave", () => { hover = null; solHover = null; arrastre = null; info.setText(infoBase); });
  canvas.addEventListener("click", (e) => {
    if (arrastre && arrastre.movido > 4) return;
    if (hover) abrir(hover.path, e.ctrlKey || e.metaKey);
    else if (solHover) irA({ tipo: "anio", a: solHover.a });
  });
  canvas.addEventListener("dblclick", () => { if (!hover && !solHover) irA({ tipo: "galaxia" }); });
  canvas.addEventListener("wheel", (e) => { e.preventDefault(); ponerZoom(zoomExtra * (e.deltaY < 0 ? 1.1 : 1 / 1.1)); }, { passive: false });
  let dentro = false;
  caja.addEventListener("mouseenter", () => { dentro = true; });
  caja.addEventListener("mouseleave", () => { dentro = false; });
  const teclas = (e) => {
    if (!root.isConnected) { window.removeEventListener("keydown", teclas, true); return; }
    if (!dentro || !(e.ctrlKey || e.metaKey)) return;
    const k = e.key;
    if (k === "+" || k === "=" || k === "Add") ponerZoom(zoomExtra * 1.25);
    else if (k === "-" || k === "Subtract") ponerZoom(zoomExtra / 1.25);
    else if (k === "0") ponerZoom(1);
    else return;
    e.preventDefault(); e.stopPropagation();
  };
  window.addEventListener("keydown", teclas, true);

  // ---------- Menú de navegación (desplegables) ----------
  // NAVEGACIÓN · GALAXIA UNED → núcleo, vista completa y, por año, sus cuatrimestres y asignaturas.
  const montarMenu = () => {
    menu.empty();
    // todo el menú es un desplegable: cerrado solo se ve el título
    const raiz = el(menu, "details", "jv-nav-raiz");
    raiz.open = !!window.jvMenuAbierto;
    raiz.addEventListener("toggle", () => { window.jvMenuAbierto = raiz.open; });
    const cab = el(raiz, "summary", "jv-nav-t", "UNIVERSO AARON › GALAXIA UNED");
    cab.title = "Abrir o cerrar el menú de navegación";
    const cuerpo = el(raiz, "div", "jv-nav-c");
    const abiertos = (window.jvMenuDet = window.jvMenuDet || {});
    const recordar = (det, clave) => { // cada desplegable recuerda si estaba abierto (empiezan cerrados)
      det.open = !!abiertos[clave];
      det.addEventListener("toggle", () => { abiertos[clave] = det.open; });
    };
    const item = (padre, txt, color, f, extra) => {
      const b = el(padre, "button", "jv-nav-i");
      const d = el(b, "span", "jv-dot"); d.style.color = color;
      b.appendText(txt);
      if (extra) el(b, "span", "jv-nav-x", extra);
      b.onclick = (e) => { e.stopPropagation(); irA(f); marcar(); };
      b.dataset.foco = JSON.stringify(f);
      return b;
    };
    item(cuerpo, "CENTRO · AARON + JARVIS", "#e8fbff", { tipo: "centro" });
    item(cuerpo, "AARON · decisiones y memoria", "#c9a7ff", { tipo: "aaron" }, `${nAaron} notas`).addClass("jv-nav-sub");
    item(cuerpo, "JARVIS · el agente", "#3ee8ff", { tipo: "nucleo" }, `${nCore} notas`).addClass("jv-nav-sub");
    item(cuerpo, "GALAXIA UNED COMPLETA", "#e8fbff", { tipo: "galaxia" });
    for (const s of anios) {
      const det = el(cuerpo, "details", "jv-nav-d");
      recordar(det, `a${s.a}`);
      const sum = el(det, "summary", "jv-nav-s");
      const d = el(sum, "span", "jv-dot"); d.style.color = s.color;
      sum.appendText(`AÑO ${s.a}`);
      el(sum, "span", "jv-nav-x", s.activo ? `${s.planetas.length} asig.` : "por explorar");
      item(det, `Ir al sistema del año ${s.a}`, s.color, { tipo: "anio", a: s.a }).addClass("jv-nav-sub");
      for (const c of [1, 2]) {
        const ps = s.planetas.filter((p) => p.cuatri === c);
        const dc = el(det, "details", "jv-nav-d jv-nav-sub");
        recordar(dc, `a${s.a}c${c}`);
        const sc = el(dc, "summary", "jv-nav-s");
        sc.appendText(`${c}.º CUATRIMESTRE`);
        el(sc, "span", "jv-nav-x", ps.length ? `${ps.length}` : "vacío");
        for (const p of ps) item(dc, `${p.k} · ${p.nombre}`, p.color, { tipo: "planeta", k: p.k }, p.activa ? `${p.pct}%` : "por cursar").addClass("jv-nav-sub2");
      }
    }
    if (rutas.length) {
      const dr = el(cuerpo, "details", "jv-nav-d");
      recordar(dr, "rutas");
      const sr = el(dr, "summary", "jv-nav-s");
      sr.appendText("CONEXIONES ENTRE ASIGNATURAS"); el(sr, "span", "jv-nav-x", `${rutas.length}`);
      for (const r of rutas) item(dr, `${r.de} ⇄ ${r.a}`, planetaDe[r.de].color, { tipo: "planeta", k: r.de }, r.tema).addClass("jv-nav-sub");
    }
    marcar();
  };
  const marcar = () => {
    const actual = JSON.stringify(foco);
    menu.querySelectorAll(".jv-nav-i").forEach((b) => b.toggleClass("jv-nav-on", b.dataset.foco === actual));
  };
  montarMenu();
  bGal.addEventListener("click", marcar); bNuc.addEventListener("click", marcar);
  canvas.addEventListener("click", () => setTimeout(marcar, 0));
  canvas.addEventListener("dblclick", () => setTimeout(marcar, 0));

  // el foco empieza ya colocado (sin animación desde cero)
  const t0 = performance.now() / 1000;
  for (const s of anios) s.c = solPos(s, t0);
  const o0 = objetivo(t0); F[0] = o0[0]; F[1] = o0[1]; F[2] = o0[2];
  setTimeout(() => { medir(); bucle(); }, 30);
};

// ---------- Montaje según el modo ----------
if (MODO === "nucleo") {
  modCabecera(root);
  modGalaxia(root); // vista anterior (planeta + lunas): modGrafo(root)
} else if (MODO === "izquierda") {
  modBriefing(root);
  modTutoria(root);
  modSistemas(root);
  modRepasos(root);
  modSemana(root);
  modCalor(root);
} else if (MODO === "derecha") {
  modPrioridades(root);
  modObjetivos(root);
  modRitmo(root);
  modPomodoro(root);
  modRegistro(root);
} else {
  modCabecera(root);
  const grid = el(root, "div", "jv-grid");
  modBriefing(grid);
  modReactor(grid);
  modTutoria(grid);
  modSistemas(grid);
  modPomodoro(grid);
  modObjetivos(grid);
  modRepasos(grid);
  modRegistro(grid);
}

// ---------- Bucle de 1 s ----------
const tick = () => {
  if (!root.isConnected) {
    clearInterval(intervalo);
    // Si ya no queda ninguna vista JARVIS abierta, se devuelve la interfaz normal
    if (!document.querySelector(".jv-m-nucleo, .jv-m-izquierda, .jv-m-derecha") && document.body.hasClass("jv-mode")) {
      document.body.removeClass("jv-mode");
      temaTerminal(false);
    }
    return;
  }
  // Pestañas de terminal nuevas, o Lean Terminal que repinta con su tema al cambiar el de Obsidian
  if (MODO === "nucleo" && document.body.hasClass("jv-mode")) temaTerminal(true);
  ticks.forEach((f) => f());
};
const intervalo = setInterval(tick, 1000);
tick();
