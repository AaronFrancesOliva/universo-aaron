    trazo(pts, "#b388ff", 2.4, 0.2, 0.45, 12, null, J, len);
    trazo(pts, "#3ee8ff", 0.8, 0.2, 0.6, 0, null, J, len);
    for (let i = 0; i < 6; i++) {
      const u = (t * 0.25 + i / 6) % 1, haciaAaron = i % 2 === 0;
