      ctx.globalAlpha = 0.7; ctx.fillStyle = haciaAaron ? "#d6a8ff" : "#3ee8ff";
      ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 10;
      ctx.beginPath(); ctx.arc(q[0], q[1], 2.2 * q[3], 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };
  const dibujarHaz = (s) => { // AARON ↔ sol: haz con pulsos (del color del sol hacia AARON, cian hacia el sol)
    const len = Math.hypot(...s.c), dir = s.c.map((v) => v / len);
    const ini = dir.map((v) => v * (DISCO[1] + 0.1)), fin = dir.map((v) => v * (len - R_SOL * 1.4));
