  const zoomDe = (f) => (f.tipo === "nucleo" ? VIEW_R / 1.8 : f.tipo === "aaron" ? VIEW_R / 2.6 : f.tipo === "centro" ? VIEW_R / 5
    : f.tipo === "anio" ? VIEW_R / (anios[f.a - 1].radio + 0.9)
