  const objetivo = (t) => (foco.tipo === "anio" ? solPos(anios[foco.a - 1], t)
    : foco.tipo === "planeta" && planetaDe[foco.k] ? planetaDe[foco.k].c || solPos(planetaDe[foco.k].sol, t)
    : foco.tipo === "nucleo" ? jarvisPos(t) : foco.tipo === "centro" ? J.map((v) => v / 2) : [0, 0, 0]);

  const solPos = (s, t) => { const th = s.th0 + t * s.vel; return [Math.cos(th) * s.R, Math.sin(th * 2) * 0.12, Math.sin(th) * s.R]; };
  const planetaPos = (p, t) => { const a = p.fase + t * p.vel; return suma(p.sol.c, rotar([Math.cos(a) * p.r, 0, Math.sin(a) * p.r], p.incX, p.incZ)); };
  const enPlaneta = (p, q, t) => suma(p.c, giraY(q, t * p.giro), R_PLANETA);

  // Proyección: [x, y, profundidad relativa al cuerpo (0 detrás … 1 delante), escala]
  const camZ = (p) => {
    const x = p[0] - F[0], y = p[1] - F[1], z = p[2] - F[2];
    let c = Math.cos(yaw), s = Math.sin(yaw);
    const x1 = x * c - z * s, z1 = x * s + z * c;
