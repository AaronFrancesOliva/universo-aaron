        q.u = (q.u + q.v * 0.016) % 1;
        const r = q.r0 * (1 - q.u) + R_BH * q.u, a = q.a0 + q.u * 7;
        const s = proy(enDisco([Math.cos(a) * r, 0, Math.sin(a) * r]), O, 2.5);
        ctx.globalAlpha = 0.15 + 0.6 * q.u; ctx.fillStyle = q.u > 0.7 ? "#ffffff" : "#c9a7ff";
        ctx.fillRect(s[0] - 0.8, s[1] - 0.8, 1.6, 1.6);
      }
    }
    // disco de acreción (partículas), mitad trasera o delantera
    for (const d of discoP) {
