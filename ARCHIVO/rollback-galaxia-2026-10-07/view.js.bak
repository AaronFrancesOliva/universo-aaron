// J.A.R.V.I.S. — panel de estudio UNED.
// Uso: dv.view("PLANIFICACION/Jarvis", { modo })
//   modo "completo"  → todo en una nota ([[Panel de estudio]])
//   modo "nucleo"    → cabecera + grafo de notas con el reactor en el centro
//   modo "izquierda" → briefing, tutoría, sistemas, repasos, semana en curso y mapa de calor
//   modo "derecha"   → prioridades de hoy, objetivos, ritmo, concentración y registro
// El botón MODO JARVIS monta la pantalla: izquierda y derecha en las barras
// laterales, núcleo en el centro y la terminal (Lean Terminal) debajo.
// Datos: tareas con [fecha:: …] de PLANIFICACION/Calendario y propiedades
// (asignatura, tema, estado, proximo_repaso) de las notas de tema.

// ---------- Configuración ----------
// Si cambian las tutorías o el nº de temas, se actualiza aquí (y en Calendario).
const CFG = {
  nombre: "Aaron",
  asig: {
    GEI: { nombre: "Gestión de Empresas Informáticas", carpeta: "GESTION DE EMPRESAS", color: "#3ee8ff", temas: 14 },
    LED: { nombre: "Lógica y Estructuras Discretas", carpeta: "LOGICA Y ESTRUCTURAS DISCRETAS", color: "#b388ff", temas: null },
    FSD: { nombre: "Fundamentos de Sistemas Digitales", carpeta: "FUNDAMENTOS DE SISTEMAS DEGITALES", color: "#ffb547", temas: 10, temasExamen: 9 }, // el tema 10 no entra
  },
  otrasCarpetas: { PLANIFICACION: "#e8fbff", LIBROS: "#4dffb5" },
  // Hora canaria (la del ordenador). dia: 1 = lunes … 7 = domingo
  tutorias: [
    { dia: 1, ini: "16:00", fin: "17:00", asig: "GEI", modo: "Solo AVIP" },
    { dia: 3, ini: "17:00", fin: "18:00", asig: "LED", modo: "Presencial + AVIP" },
    { dia: 3, ini: "19:00", fin: "20:00", asig: "FSD", modo: "Presencial + AVIP" },
  ],
  pomodoro: { foco: 25, descanso: 5 }, // minutos
  horizonte: 60,   // días que abarca la barra de cada objetivo
  maxObjetivos: 8,
  maxObjetivosLateral: 1, // en la columna derecha del modo JARVIS: el resto, con "+N más"
};
const RUTAS = {
  nucleo: "PLANIFICACION/Jarvis/JARVIS Núcleo.md",
  izquierda: "PLANIFICACION/Jarvis/JARVIS Izquierda.md",
  derecha: "PLANIFICACION/Jarvis/JARVIS Derecha.md",
};
const TIPO_TERMINAL = "terminal-view"; // vista de Lean Terminal
const PESO = { pendiente: 0, leido: 1 / 3, resumido: 2 / 3, dominado: 1 };
const DIAS = ["", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"];

const MODO = (input && input.modo) || "completo";
const EN_HUD = MODO !== "completo";

// ---------- Utilidades ----------
const app = window.app;
const moment = window.moment;
const HOY = dv.date("today");
const pad = (n) => String(n).padStart(2, "0");
const el = (parent, tag, cls, text) => {
  const e = parent.createEl(tag, { cls });
  if (text != null) e.setText(String(text));
  return e;
};
const panel = (parent, titulo, area, extra) => {
  const p = el(parent, "section", `jv-panel ${area}`);
  const h = el(p, "header", "jv-panel-h");
  el(h, "span", "jv-panel-t", titulo);
  el(h, "span", "jv-panel-deco");
  if (extra) el(h, "span", "jv-panel-x", extra);
  return el(p, "div", "jv-panel-b");
};
// En modo JARVIS las notas se abren en una ventana aparte para no romper la pantalla
const abrir = (ruta, nueva) => {
  const f = app.metadataCache.getFirstLinkpathDest(ruta.replace(/\.md$/, ""), "") || app.vault.getAbstractFileByPath(ruta);
  if (!f) return;
  const leaf = document.body.hasClass("jv-mode") ? app.workspace.getLeaf("window") : app.workspace.getLeaf(nueva ? "tab" : false);
  leaf.openFile(f);
};
const enlace = (parent, ruta, texto) => {
  const a = el(parent, "a", "jv-link", texto);
  a.href = "#";
  a.onclick = (e) => { e.preventDefault(); abrir(ruta, e.ctrlKey || e.metaKey); };
  return a;
};
const cuenta = (ms) => {
  const s = Math.floor(Math.abs(ms) / 1000);
  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
  const txt = `${d ? d + "d " : ""}${pad(h)}:${pad(m)}:${pad(s % 60)}`;
  return ms < 0 ? `VENCIDO +${txt}` : `T-${txt}`;
};
const store = {
  get(k) { try { return JSON.parse(localStorage.getItem(k)); } catch { return null; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
  sget(k) { try { return sessionStorage.getItem(k); } catch { return null; } },
  sset(k, v) { try { sessionStorage.setItem(k, v); } catch {} },
};
const aviso = (msg) => { try { new Notice(msg, 8000); } catch {} };

// ---------- Datos ----------
const claves = Object.keys(CFG.asig);
const claveDe = (nombre) => claves.find((k) => CFG.asig[k].nombre === nombre);
const asigDeTexto = (txt) => claves.find((k) => txt.startsWith(k + ":"));
const diasHasta = (f) => Math.round(f.startOf("day").diff(HOY, "days").days);
const limpiar = (txt) => txt.replace(/\s*\[fecha::[^\]]*\]/, "").replace(/^(GEI|LED|FSD):\s*/, "");
// Hora límite: la que diga el texto ("22:59 de Canarias"); si no dice ninguna, 23:59.
const momentoDe = (t) => {
  const m = t.text.match(/(\d{1,2}):(\d{2}) de Canarias/);
  const base = t.fecha.startOf("day");
  return (m ? base.set({ hour: +m[1], minute: +m[2] }) : base.set({ hour: 23, minute: 59 })).toMillis();
};

const temas = dv.pages().where((p) => p.tema && p.asignatura);
const cal = dv.page("PLANIFICACION/Calendario");
const tareas = (cal ? cal.file.tasks : dv.array([]))
  .where((t) => !t.completed && t.fecha)
  .sort((t) => t.fecha, "asc");
const repasos = temas.where((p) => p.proximo_repaso && diasHasta(p.proximo_repaso) <= 7)
  .sort((p) => p.proximo_repaso, "asc");
const repasosHoy = repasos.where((p) => diasHasta(p.proximo_repaso) <= 0);

const progreso = claves.map((k) => {
  const a = CFG.asig[k];
  const ts = temas.where((p) => p.asignatura === a.nombre);
  const total = a.temas ?? ts.length;
  const avance = ts.array().reduce((s, p) => s + (PESO[p.estado] ?? 0), 0);
  return {
    k, a, total, notas: ts.length,
    pct: total ? Math.round((100 * avance) / total) : 0,
    dominados: ts.where((p) => p.estado === "dominado").length,
  };
});
const global = Math.round(progreso.reduce((s, x) => s + x.pct, 0) / progreso.length);

const proxTutoria = () => {
  const ahora = moment();
  for (let d = 0; d <= 7; d++) {
    const dia = ahora.clone().add(d, "days");
    const delDia = CFG.tutorias.filter((x) => x.dia === dia.isoWeekday()).sort((a, b) => a.ini.localeCompare(b.ini));
    for (const t of delDia) {
      const [hi, mi] = t.ini.split(":"), [hf, mf] = t.fin.split(":");
      const ini = dia.clone().hour(+hi).minute(+mi).second(0);
      const fin = dia.clone().hour(+hf).minute(+mf).second(0);
      if (fin.isAfter(ahora)) return { ...t, iniM: ini, finM: fin, d };
    }
  }
  return null;
};

// ---------- Modo JARVIS (ocupa toda la ventana de Obsidian) ----------
const FLAG = "jarvis-modo";
const ventana = () => {
  const candidatos = [
    () => window.electronWindow,
    () => window.require("@electron/remote").getCurrentWindow(),
    () => window.require("electron").remote.getCurrentWindow(),
  ];
  for (const c of candidatos) { try { const w = c(); if (w && w.setFullScreen) return w; } catch {} }
  return null;
};
// Versiones anteriores ponían la pantalla completa del sistema: al salir se deshace
const quitarPantallaCompleta = () => {
  const w = ventana();
  try { if (w && w.isFullScreen()) w.setFullScreen(false); } catch {}
  document.body.removeClass("jv-fs");
};

// ---------- Terminal con colores HUD ----------
// Lean Terminal pinta con xterm.js, así que los colores se cambian en sus opciones (no basta con CSS)
const TEMA_TERMINAL = {
  background: "#03070c", foreground: "#cdf6ff", cursor: "#3ee8ff", cursorAccent: "#03070c",
  selectionBackground: "rgba(62, 232, 255, .30)",
  black: "#03070c", red: "#ff4d6a", green: "#4dffb5", yellow: "#ffb547", blue: "#3ea6ff", magenta: "#b388ff", cyan: "#3ee8ff", white: "#cdf6ff",
  brightBlack: "#5f8a99", brightRed: "#ff7a90", brightGreen: "#8affd0", brightYellow: "#ffd08a", brightBlue: "#7cc4ff", brightMagenta: "#d0b8ff", brightCyan: "#9af4ff", brightWhite: "#ffffff",
};
const sesionesTerminal = () => app.workspace.getLeavesOfType(TIPO_TERMINAL)
  .flatMap((l) => (l.view && l.view.tabManager && l.view.tabManager.sessions) || []);
const temaTerminal = (on) => {
  for (const s of sesionesTerminal()) {
    const t = s.terminal;
    if (!t || !t.options) continue;
    if (on) { if (t.options.theme && t.options.theme.background !== TEMA_TERMINAL.background) t.options.theme = { ...TEMA_TERMINAL }; }
  }
  // Al salir, Lean Terminal recupera su propio tema
  if (!on) app.workspace.getLeavesOfType(TIPO_TERMINAL).forEach((l) => { try { l.view.tabManager.updateTheme(); } catch {} });
};
const abrirEn = async (leaf, ruta) => {
  const f = app.vault.getAbstractFileByPath(ruta);
  if (!f) { aviso(`Falta la nota ${ruta}`); return; }
  await leaf.openFile(f, { state: { mode: "preview" } });
};
const hojaCon = (ruta) => app.workspace.getLeavesOfType("markdown").find((l) => l.view.file && l.view.file.path === ruta);
const activarModo = async () => {
  const ws = app.workspace;
  // 1. La terminal: se reutiliza la que haya (no se corta la sesión de Claude)
  const terminales = ws.getLeavesOfType(TIPO_TERMINAL);
  let term = terminales.find((l) => l.getRoot() === ws.rootSplit) || terminales[0];
  if (term && term.getRoot() !== ws.rootSplit) {
    // Está en una barra lateral: se mueve al área central sin cerrarla (como al arrastrarla)
    try {
      let destino = null;
      ws.iterateRootLeaves((l) => { if (!destino) destino = l.parent; });
      if (!destino) destino = ws.getLeaf("tab").parent;
      term.parent.removeChild(term);
      destino.insertChild(destino.children.length, term);
      if (destino.selectTab) destino.selectTab(term);
    } catch (e) {
      console.error("JARVIS: no se pudo mover la terminal", e);
      term = null;
    }
  }
  if (!term || term.getRoot() !== ws.rootSplit) {
    term = ws.getLeaf("tab");
    await term.setViewState({ type: TIPO_TERMINAL, active: true });
  }
  // 2. Se cierran las demás pestañas del área central (solo pestañas, no archivos)
  const cerrar = [];
  ws.iterateRootLeaves((l) => { if (l !== term && l.view.getViewType() !== TIPO_TERMINAL) cerrar.push(l); });
  cerrar.forEach((l) => l.detach());
  // 3. El núcleo siempre se crea de nuevo encima de la terminal (arriba núcleo, abajo terminal)
  const nucleo = ws.createLeafBySplit(term, "horizontal", true);
  await abrirEn(nucleo, RUTAS.nucleo);
  try { term.view.onResize && term.view.onResize(); } catch {}
  // 4. Columnas en las barras laterales
  for (const [lado, ruta] of [["izquierda", RUTAS.izquierda], ["derecha", RUTAS.derecha]]) {
    let hoja = hojaCon(ruta);
    if (!hoja) {
      hoja = lado === "izquierda" ? ws.getLeftLeaf(false) : ws.getRightLeaf(false);
      await abrirEn(hoja, ruta);
    }
    ws.revealLeaf(hoja);
  }
  ws.leftSplit.expand();
  ws.rightSplit.expand();
  try {
    ws.leftSplit.setSize(Math.round(window.innerWidth * 0.24));
    ws.rightSplit.setSize(Math.round(window.innerWidth * 0.26));
  } catch {}
  store.set(FLAG, true);
  document.body.addClass("jv-mode");
  quitarPantallaCompleta();
  temaTerminal(true);
  ws.setActiveLeaf(term, { focus: true });
};
const salirModo = () => {
  store.set(FLAG, false);
  document.body.removeClass("jv-mode");
  quitarPantallaCompleta();
  temaTerminal(false);
};
// Versiones anteriores ponían un botón fijo de salida abajo a la izquierda: ahora ese hueco es del mapa de calor
document.getElementById("jv-exit")?.remove();
// Atajo Ctrl+Shift+J para salir (se registra una sola vez)
if (!window.jvAtajoSalir) {
  window.jvAtajoSalir = true;
  window.addEventListener("keydown", (e) => {
    if (e.ctrlKey && e.shiftKey && e.code === "KeyJ" && document.body.hasClass("jv-mode")) {
      e.preventDefault(); e.stopPropagation();
      store.set(FLAG, false);
      document.body.removeClass("jv-mode");
      quitarPantallaCompleta();
      temaTerminal(false);
    }
  }, true);
}
if (EN_HUD && store.get(FLAG)) document.body.addClass("jv-mode");

// ---------- Micrófono: dictado de Windows (Win + H) en la terminal ----------
// Pone el foco en la terminal y pulsa Win + H con PowerShell (oculto). Volver a pulsarlo cierra el dictado.
const PULSAR_WIN_H = `Add-Type -Name K -Namespace W -MemberDefinition '[DllImport("user32.dll")] public static extern void keybd_event(byte b, byte s, uint f, UIntPtr e);';`
  + " [W.K]::keybd_event(0x5B,0,0,[UIntPtr]::Zero); [W.K]::keybd_event(0x48,0,0,[UIntPtr]::Zero);"
  + " [W.K]::keybd_event(0x48,0,2,[UIntPtr]::Zero); [W.K]::keybd_event(0x5B,0,2,[UIntPtr]::Zero)";
const dictar = () => {
  const term = app.workspace.getLeavesOfType(TIPO_TERMINAL)[0];
  if (!term) { aviso("No hay ninguna terminal abierta para dictar."); return; }
  app.workspace.setActiveLeaf(term, { focus: true });
  try { term.view.tabManager.focusActive(); } catch {}
  try {
    window.require("child_process").execFile("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", PULSAR_WIN_H],
      { windowsHide: true }, (err) => { if (err) aviso("No se pudo abrir el dictado de Windows: pulsa Win + H."); });
  } catch { aviso("No se pudo abrir el dictado de Windows: pulsa Win + H."); }
};

// ---------- Estructura ----------
const root = el(dv.container, "div", `jv jv-m-${MODO}`);
const ticks = [];

// ---------- Cabecera ----------
const modCabecera = (parent) => {
  const top = el(parent, "div", "jv-top");
  const logo = el(top, "div");
  el(logo, "span", "jv-logo-t", "J.A.R.V.I.S.");
  el(logo, "span", "jv-logo-s", "SISTEMA DE ESTUDIO · UNED");
  const reloj = el(top, "div", "jv-clock");
  const derecha = el(top, "div", "jv-top-r");
  el(derecha, "div", null, HOY.setLocale("es").toFormat("cccc d LLLL yyyy").toUpperCase());
  const semana = moment().format("gggg-[W]ww");
  const rutaSemana = `PLANIFICACION/Semanas/${semana}`;
  const semEl = el(derecha, "div");
  if (dv.page(rutaSemana)) enlace(semEl, rutaSemana, `SEMANA ${semana} ▸`);
  else el(semEl, "span", "jv-dim", `SEMANA ${semana} · SIN NOTA`);
  el(derecha, "div", "jv-online", "EN LÍNEA · HORA DE CANARIAS");
  const btns = el(derecha, "div", "jv-btns jv-btns-r");
  const bMic = el(btns, "button", "jv-btn jv-mic", "🎙 HABLAR");
  bMic.title = "Dictar a Claude en la terminal (dictado de Windows, Win + H). Púlsalo otra vez para parar.";
  bMic.onclick = dictar;
  const bModo = el(btns, "button", "jv-btn");
  const pintarBoton = () => bModo.setText(document.body.hasClass("jv-mode") ? "SALIR DEL MODO JARVIS" : "MODO JARVIS");
  bModo.onclick = async () => {
    if (document.body.hasClass("jv-mode")) salirModo();
    else { bModo.setText("INICIANDO…"); await activarModo(); }
    pintarBoton();
  };
  pintarBoton();
  ticks.push(() => { if (bModo.textContent !== "INICIANDO…") pintarBoton(); }); // por si se sale con el botón fijo o el atajo
  ticks.push(() => {
    const m = moment();
    reloj.empty();
    reloj.appendText(m.format("HH:mm"));
    el(reloj, "small", null, m.format(":ss"));
  });
};

// ---------- Briefing ----------
const modBriefing = (parent) => {
  const b = panel(parent, "BRIEFING", "jv-a-brief");
  const briefTxt = el(b, "div", "jv-brief");
  const h = new Date().getHours();
  const saludo = h < 6 ? "Buenas noches" : h < 14 ? "Buenos días" : h < 21 ? "Buenas tardes" : "Buenas noches";
  const lineas = [`${saludo}, ${CFG.nombre}.`];
  lineas.push(repasosHoy.length
    ? `Tienes ${repasosHoy.length} ${repasosHoy.length === 1 ? "repaso pendiente" : "repasos pendientes"} para hoy.`
    : "No hay repasos pendientes hoy.");
  const sig = tareas.where((t) => momentoDe(t) >= Date.now()).first();
  if (sig) {
    const n = diasHasta(sig.fecha);
    lineas.push(`Próximo objetivo: ${limpiar(sig.text)}, ${n === 0 ? "hoy" : n === 1 ? "mañana" : `en ${n} días`}.`);
  }
  const vencidos = tareas.where((t) => momentoDe(t) < Date.now()).length;
  if (vencidos) lineas.push(`Atención: ${vencidos} ${vencidos === 1 ? "objetivo vencido" : "objetivos vencidos"} sin marcar.`);
  const semanaCrit = tareas.where((t) => { const n = diasHasta(t.fecha); return n >= 0 && n <= 7; }).length;
  if (semanaCrit) lineas.push(`${semanaCrit} ${semanaCrit === 1 ? "fecha" : "fechas"} en los próximos 7 días.`);
  lineas.push(`Progreso global del curso: ${global} %.`);
  const texto = lineas.join("\n");

  // Efecto máquina de escribir solo la primera vez que cambia el texto
  const cursor = el(briefTxt, "span", "jv-cursor");
  if (store.sget("jarvis-brief") === texto) {
    briefTxt.insertBefore(document.createTextNode(texto), cursor);
  } else {
    store.sset("jarvis-brief", texto);
    const nodo = briefTxt.insertBefore(document.createTextNode(""), cursor);
    let i = 0;
    const tw = setInterval(() => {
      if (!root.isConnected || i >= texto.length) { clearInterval(tw); return; }
      nodo.textContent += texto[i++];
    }, 16);
  }
};

// ---------- Reactor (progreso) ----------
const svgReactor = (conTexto = true) => {
  const radios = [100, 84, 68];
  const anillos = progreso.map((x, i) => {
    const r = radios[i], circ = 2 * Math.PI * r;
    return `<circle cx="130" cy="130" r="${r}" class="jv-ring-bg"/>
      <circle cx="130" cy="130" r="${r}" class="jv-ring" stroke="${x.a.color}"
        data-final="${(circ * x.pct) / 100} ${circ}" stroke-dasharray="0 ${circ}" transform="rotate(-90 130 130)"/>`;
  }).join("");
  return `<svg viewBox="0 0 260 260" class="jv-reactor">
    <defs><radialGradient id="jv-core-grad-${MODO}">
      <stop offset="0%" stop-color="#ffffff" stop-opacity=".95"/>
      <stop offset="35%" stop-color="#3ee8ff" stop-opacity=".55"/>
      <stop offset="100%" stop-color="#3ee8ff" stop-opacity="0"/>
    </radialGradient></defs>
    <circle cx="130" cy="130" r="126" class="jv-deco jv-spin"/>
    <circle cx="130" cy="130" r="115" class="jv-ticks jv-spin-rev"/>
    ${anillos}
    <circle cx="130" cy="130" r="54" class="jv-inner jv-spin-rev"/>
    <circle cx="130" cy="130" r="46" class="jv-core" fill="url(#jv-core-grad-${MODO})"/>
    ${conTexto ? `<text x="130" y="134" class="jv-core-num">${global}%</text>
    <text x="130" y="152" class="jv-core-lbl">GLOBAL</text>` : ""}
  </svg>`;
};
const animarAnillos = (cont) =>
  setTimeout(() => cont.querySelectorAll(".jv-ring").forEach((c) => c.setAttribute("stroke-dasharray", c.dataset.final)), 60);
const leyendaProgreso = (parent) => {
  const ley = el(parent, "div", "jv-legend");
  for (const x of progreso) {
    const s = el(ley, "span");
    el(s, "span", "jv-dot").style.color = x.a.color;
    el(s, "b", null, `${x.k} ${x.pct}%`);
    el(s, "span", "jv-dim", x.total ? ` · ${x.notas}/${x.total} temas` : " · sin notas");
  }
};
const modReactor = (parent) => {
  const b = panel(parent, "NÚCLEO DE PROGRESO", "jv-a-core");
  const wrap = el(b, "div", "jv-reactor-wrap");
  wrap.innerHTML = svgReactor();
  animarAnillos(wrap);
  leyendaProgreso(b);
};

// ---------- Tutoría ----------
const modTutoria = (parent) => {
  const b = panel(parent, "PRÓXIMA TUTORÍA", "jv-a-tut");
  const tutAsig = el(b, "div", "jv-big");
  const tutCd = el(b, "div", "jv-kv");
  const tutDia = el(b, "div", "jv-kv");
  const tutModo = el(b, "div", "jv-kv");
  ticks.push(() => {
    const t = proxTutoria();
    if (!t) { tutAsig.setText("—"); return; }
    const ahora = moment();
    const enCurso = ahora.isAfter(t.iniM);
    tutAsig.setText(t.asig);
    tutAsig.style.color = CFG.asig[t.asig].color;
    tutCd.empty();
    el(tutCd, "span", "jv-dim", enCurso ? "EN CURSO · TERMINA" : "EMPIEZA");
    el(tutCd, "span", enCurso ? "jv-live" : null, enCurso ? cuenta(t.finM.diff(ahora)) : cuenta(t.iniM.diff(ahora)));
    tutDia.empty();
    el(tutDia, "span", "jv-dim", "CUÁNDO");
    el(tutDia, "span", null, `${t.d === 0 ? "hoy" : t.d === 1 ? "mañana" : DIAS[t.dia]} ${t.ini}-${t.fin}`);
    tutModo.empty();
    el(tutModo, "span", "jv-dim", "MODALIDAD");
    el(tutModo, "span", null, t.modo);
  });
};

// ---------- Estado de sistemas (asignaturas) ----------
const modSistemas = (parent) => {
  const b = panel(parent, "ESTADO DE SISTEMAS", "jv-a-sys");
  for (const x of progreso) {
    const fila = el(b, "div", "jv-sys");
    el(fila, "span", "jv-sys-k", x.k).style.color = x.a.color;
    const relleno = el(el(fila, "div", "jv-mini"), "div");
    relleno.style.width = `${x.pct}%`;
    relleno.style.background = x.a.color;
    relleno.style.color = x.a.color;

    const prox = tareas.where((t) => asigDeTexto(t.text) === x.k).first();
    const n = prox ? diasHasta(prox.fecha) : null;
    const atrasados = repasosHoy.where((p) => p.asignatura === x.a.nombre).length;
    const [cls, txt] = n !== null && n <= 3 ? ["jv-st-crit", "CRÍTICO"]
      : (n !== null && n <= 14) || atrasados ? ["jv-st-warn", "ATENCIÓN"]
      : ["jv-st-ok", "NOMINAL"];
    el(fila, "span", `jv-status ${cls}`, txt);
    el(fila, "div", "jv-sys-d", prox
      ? `PRÓX ▸ ${limpiar(prox.text)} · ${n < 0 ? `vencido hace ${-n} d` : n === 0 ? "hoy" : `${n} d`}`
      : "Sin objetivos en el calendario");
  }
};

// ---------- Concentración (pomodoro) ----------
const modPomodoro = (parent) => {
  const b = panel(parent, "MODO CONCENTRACIÓN", "jv-a-pomo");
  const KEY = "jarvis-pomodoro";
  const DUR = { foco: CFG.pomodoro.foco * 60000, descanso: CFG.pomodoro.descanso * 60000 };
  const hoyISO = moment().format("YYYY-MM-DD");
  let pomo = store.get(KEY);
  if (!pomo || !DUR[pomo.modo]) pomo = { modo: "foco", fin: null, resto: DUR.foco, dia: hoyISO, ciclos: 0 };
  if (pomo.dia !== hoyISO) { pomo.dia = hoyISO; pomo.ciclos = 0; }
  store.set(KEY, pomo);

  const PR = 56, PCIRC = 2 * Math.PI * PR;
  const pWrap = el(b, "div");
  pWrap.innerHTML = `<svg viewBox="0 0 140 140" class="jv-pomo">
    <circle cx="70" cy="70" r="${PR}" class="jv-ring-bg"/>
    <circle cx="70" cy="70" r="${PR}" class="jv-pomo-arc" transform="rotate(-90 70 70)" stroke-dasharray="${PCIRC} ${PCIRC}"/>
    <text x="70" y="74" class="jv-pomo-t">25:00</text>
    <text x="70" y="92" class="jv-pomo-m">FOCO</text>
  </svg>`;
  const pSvg = pWrap.querySelector("svg");
  const pArc = pWrap.querySelector(".jv-pomo-arc");
  const pT = pWrap.querySelector(".jv-pomo-t");
  const pM = pWrap.querySelector(".jv-pomo-m");
  const btns = el(b, "div", "jv-btns");
  const bPlay = el(btns, "button", "jv-btn", "INICIAR");
  const bReset = el(btns, "button", "jv-btn", "REINICIAR");
  const bSkip = el(btns, "button", "jv-btn", "SALTAR");
  const pInfo = el(b, "div", "jv-pomo-info");

  const pitido = () => {
    try {
      const ctx = new AudioContext();
      [0, 0.28, 0.56].forEach((t) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.frequency.value = 880;
        o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.15, ctx.currentTime + t);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 0.22);
        o.start(ctx.currentTime + t); o.stop(ctx.currentTime + t + 0.24);
      });
    } catch {}
  };
  const restante = () => (pomo.fin ? pomo.fin - Date.now() : pomo.resto);
  const cambiarModo = (contar) => {
    if (contar && pomo.modo === "foco") pomo.ciclos++;
    pomo.modo = pomo.modo === "foco" ? "descanso" : "foco";
    pomo.fin = null;
    pomo.resto = DUR[pomo.modo];
    store.set(KEY, pomo);
  };
  const pintar = () => {
    // Otra vista del panel puede haber cambiado el estado
    const guardado = store.get(KEY);
    if (guardado) pomo = guardado;
    if (pomo.fin && pomo.fin <= Date.now()) {
      const eraFoco = pomo.modo === "foco";
      cambiarModo(true);
      pitido();
      aviso(eraFoco ? "J.A.R.V.I.S.: bloque de foco completado. Toca descansar." : "J.A.R.V.I.S.: descanso terminado. Vuelta al estudio.");
    }
    const ms = Math.max(0, restante());
    pT.textContent = `${pad(Math.floor(ms / 60000))}:${pad(Math.floor((ms % 60000) / 1000))}`;
    pM.textContent = pomo.modo === "foco" ? "FOCO" : "DESCANSO";
    pSvg.classList.toggle("jv-break", pomo.modo === "descanso");
    pArc.setAttribute("stroke-dasharray", `${(PCIRC * ms) / DUR[pomo.modo]} ${PCIRC}`);
    bPlay.setText(pomo.fin ? "PAUSAR" : ms < DUR[pomo.modo] ? "REANUDAR" : "INICIAR");
    pInfo.setText(`CICLOS HOY: ${pomo.ciclos} · ${pomo.ciclos * CFG.pomodoro.foco} MIN DE FOCO`);
  };
  bPlay.onclick = () => {
    if (pomo.fin) { pomo.resto = Math.max(0, pomo.fin - Date.now()); pomo.fin = null; }
    else pomo.fin = Date.now() + pomo.resto;
    store.set(KEY, pomo); pintar();
  };
  bReset.onclick = () => { pomo.fin = null; pomo.resto = DUR[pomo.modo]; store.set(KEY, pomo); pintar(); };
  bSkip.onclick = () => { cambiarModo(false); pintar(); };
  ticks.push(pintar);
};

// ---------- Objetivos (cuenta atrás) ----------
const modObjetivos = (parent) => {
  const max = MODO === "derecha" ? CFG.maxObjetivosLateral : CFG.maxObjetivos;
  const b = panel(parent, "OBJETIVOS · CUENTA ATRÁS", "jv-a-obj", `${tareas.length} PENDIENTES`);
  const relojes = [];
  const completar = async (t) => {
    const file = app.vault.getAbstractFileByPath(t.path);
    if (!file) return;
    await app.vault.process(file, (data) => {
      const lineas = data.split("\n");
      if (lineas[t.line] && lineas[t.line].includes("- [ ]")) lineas[t.line] = lineas[t.line].replace("- [ ]", "- [x]");
      return lineas.join("\n");
    });
  };
  if (!tareas.length) el(b, "div", "jv-empty", "Sin objetivos pendientes en el Calendario.");
  for (const t of tareas.slice(0, max)) {
    const k = asigDeTexto(t.text);
    const objetivo = momentoDe(t);
    const fila = el(b, "div", "jv-obj");
    const chk = el(fila, "button", "jv-chk");
    chk.title = "Marcar como hecho (pulsa dos veces para confirmar)";
    let armado = null;
    chk.onclick = () => {
      if (armado) { clearTimeout(armado); chk.setText("✓"); completar(t); return; }
      chk.addClass("jv-armed"); chk.setText("?");
      armado = setTimeout(() => { armado = null; chk.removeClass("jv-armed"); chk.setText(""); }, 3000);
    };
    const chip = el(fila, "span", "jv-chip", k || "UNED");
    chip.style.color = k ? CFG.asig[k].color : "var(--dim)";
    const cuerpo = el(fila, "div", "jv-obj-t");
    el(cuerpo, "div", null, limpiar(t.text));
    const meta = el(cuerpo, "div", "jv-obj-f", moment(objetivo).locale("es").format("ddd D MMM YYYY · HH:mm"));
    if (/aprox|no publicad|según Ágora/i.test(t.text)) el(meta, "span", "jv-tag", "POR CONFIRMAR");
    const cd = el(fila, "div", "jv-cd");
    const barra = el(el(fila, "div", "jv-bar"), "div");
    relojes.push({ fila, cd, barra, objetivo });
  }
  if (tareas.length > max) {
    enlace(el(b, "div", "jv-more"), "PLANIFICACION/Calendario", `+${tareas.length - max} más en el Calendario ▸`);
  }
  ticks.push(() => {
    const ahora = Date.now();
    for (const r of relojes) {
      const ms = r.objetivo - ahora;
      const dias = ms / 86400000;
      r.cd.setText(cuenta(ms));
      r.fila.toggleClass("jv-crit", dias <= 3);
      r.fila.toggleClass("jv-warn", dias > 3 && dias <= 14);
      r.barra.style.width = `${Math.max(2, Math.min(100, 100 * (1 - dias / CFG.horizonte)))}%`;
    }
  });
};

// ---------- Repasos ----------
const modRepasos = (parent) => {
  const b = panel(parent, "PROTOCOLO DE REPASO", "jv-a-rep", "7 DÍAS");
  if (!repasos.length) el(b, "div", "jv-empty", "Sin repasos programados en los próximos 7 días.");
  for (const p of repasos) {
    const n = diasHasta(p.proximo_repaso);
    const k = claveDe(p.asignatura);
    const fila = el(b, "div", "jv-row");
    const izq = el(fila, "span");
    if (k) el(izq, "b", null, `${k} `).style.color = CFG.asig[k].color;
    enlace(izq, p.file.path, p.file.name);
    el(fila, "span", n < 0 ? "jv-late" : "jv-dim",
      n < 0 ? `ATRASADO ${-n} d` : n === 0 ? "HOY" : n === 1 ? "MAÑANA" : p.proximo_repaso.setLocale("es").toFormat("ccc d LLL"));
  }
};

// ---------- Registro de actividad ----------
const modRegistro = (parent) => {
  const b = panel(parent, "REGISTRO DEL SISTEMA", "jv-a-log");
  const st = el(b, "div", "jv-stats");
  const archivos = app.vault.getFiles();
  const dato = (etq, n) => { const s = el(st, "span", null, `${etq} `); el(s, "b", null, n); };
  dato("NOTAS", archivos.filter((f) => f.extension === "md").length);
  dato("PDF", archivos.filter((f) => f.extension === "pdf").length);
  dato("TEMAS", temas.length);
  dato("DOMINADOS", temas.where((p) => p.estado === "dominado").length);
  const recientes = dv.pages().where((p) => !p.file.path.startsWith("PLANIFICACION/Jarvis/"))
    .sort((p) => p.file.mtime, "desc").limit(6);
  for (const p of recientes) {
    const fila = el(b, "div", "jv-log-row");
    el(fila, "span", "jv-dim", p.file.mtime.setLocale("es").toFormat("dd/LL HH:mm"));
    el(fila, "span", "jv-dim", "▸ ACTUALIZADO");
    enlace(el(fila, "span"), p.file.path, p.file.name);
  }
};

// ---------- Prioridades de hoy (nota diaria de Jarvis) ----------
const RUTA_DIARIO = "PLANIFICACION/Jarvis/Diario";
const textoPlano = (txt) => txt
  .replace(/\[\[[^\]|]*\|([^\]]*)\]\]/g, "$1").replace(/\[\[([^\]]*)\]\]/g, "$1")
  .replace(/\*\*([^*]*)\*\*/g, "$1").replace(/\s*#revisar\b/g, "").trim();
const enSeccion = (x, clave) => !!(x.section && x.section.subpath && x.section.subpath.toLowerCase().includes(clave));
const modPrioridades = (parent) => {
  const ruta = `${RUTA_DIARIO}/${HOY.toFormat("yyyy-LL-dd")}`;
  const nota = dv.page(ruta);
  const prios = nota ? nota.file.tasks.where((t) => enSeccion(t, "prioridades") && textoPlano(t.text)) : dv.array([]);
  const hechas = prios.where((t) => t.completed).length;
  const b = panel(parent, "PRIORIDADES DE HOY", "jv-a-prio", prios.length ? `${hechas}/${prios.length} HECHAS` : null);
  if (!nota) { el(b, "div", "jv-empty", "Sin nota de hoy: di «buenos días» a Jarvis en la terminal."); return; }
  if (!prios.length) el(b, "div", "jv-empty", "Sin prioridades en la nota de hoy.");
  for (const t of prios) {
    const fila = el(b, "div", "jv-prio");
    const chk = el(fila, "button", "jv-chk", t.completed ? "✓" : "");
    chk.title = "Marcar o desmarcar";
    el(fila, "span", "jv-prio-t", textoPlano(t.text));
    fila.toggleClass("jv-done", t.completed);
    chk.onclick = async () => {
      const file = app.vault.getAbstractFileByPath(t.path);
      if (!file) return;
      const hecha = !fila.hasClass("jv-done");
      await app.vault.process(file, (data) => {
        const lineas = data.split("\n");
        const l = lineas[t.line];
        if (l) lineas[t.line] = hecha ? l.replace("- [ ]", "- [x]") : l.replace(/- \[[xX]\]/, "- [ ]");
        return lineas.join("\n");
      });
      fila.toggleClass("jv-done", hecha);
      chk.setText(hecha ? "✓" : "");
    };
  }
  const arrastra = nota.file.lists.where((x) => !x.task && enSeccion(x, "arrastrando") && x.text.trim());
  if (arrastra.length) {
    el(b, "div", "jv-prio-sub", "VENÍA ARRASTRANDO");
    for (const x of arrastra) el(b, "div", "jv-prio-arr", `▸ ${textoPlano(x.text)}`);
  }
  enlace(el(b, "div", "jv-more"), ruta, "Abrir la nota de hoy ▸");
};

// ---------- Ritmo hasta el examen ----------
// Temas que faltan (con el mismo peso por estado que el progreso) ÷ semanas hasta cada hito.
// Hitos: las tareas "tener estudiados los temas X-Y" del Calendario y la 1.ª semana de exámenes;
// se muestra el más exigente. Umbrales (criterio de Jarvis): ≤ 1 tema/sem nominal, ≤ 2 atención.
const modRitmo = (parent) => {
  const examen = tareas.where((t) => /^Exámenes: 1\.ª semana/.test(t.text)).first();
  const b = panel(parent, "RITMO HASTA EL EXAMEN", "jv-a-ritmo", "TEMAS / SEMANA");
  const num = (n) => n.toLocaleString("es", { maximumFractionDigits: 1 });
  for (const x of progreso) {
    const total = x.a.temasExamen ?? x.a.temas;
    const fila = el(b, "div", "jv-sys");
    el(fila, "span", "jv-sys-k", x.k).style.color = x.a.color;
    if (!total || !examen) {
      el(fila, "span", "jv-dim", "—");
      el(fila, "span", "jv-status jv-dim", "SIN DATOS");
      el(fila, "div", "jv-sys-d", !total ? "Sin nº de temas (el material está en Ágora)." : "Falta la fecha de examen en el Calendario.");
      continue;
    }
    const notas = temas.where((p) => p.asignatura === x.a.nombre);
    const falta = (hasta) => hasta - notas.where((p) => +p.tema <= hasta).array().reduce((s, p) => s + (PESO[p.estado] ?? 0), 0);
    const hitos = tareas.where((t) => asigDeTexto(t.text) === x.k && /tener estudiados/.test(t.text) && diasHasta(t.fecha) > 0)
      .array().map((t) => {
        const m = t.text.match(/temas (\d+)-(\d+)/);
        return m && { hasta: Math.min(+m[2], total), fecha: t.fecha, txt: `temas ${m[1]}-${m[2]}` };
      }).filter(Boolean);
    hitos.push({ hasta: total, fecha: examen.fecha, txt: "examen (1.ª semana)" });
    const calc = hitos.map((h) => {
      const sem = Math.max(diasHasta(h.fecha) / 7, 1 / 7);
      return { ...h, sem, falta: falta(h.hasta), ritmo: falta(h.hasta) / sem };
    }).filter((h) => h.falta > 0);
    if (!calc.length) {
      el(fila, "span", null, "al día");
      el(fila, "span", "jv-status jv-st-ok", "NOMINAL");
      el(fila, "div", "jv-sys-d", "Todos los temas estudiados.");
      continue;
    }
    const peor = calc.reduce((a, h) => (h.ritmo > a.ritmo ? h : a));
    el(fila, "span", null, `${num(peor.ritmo)} temas/sem`);
    const [cls, txt] = peor.ritmo > 2 ? ["jv-st-crit", "CRÍTICO"] : peor.ritmo > 1 ? ["jv-st-warn", "ATENCIÓN"] : ["jv-st-ok", "NOMINAL"];
    el(fila, "span", `jv-status ${cls}`, txt);
    el(fila, "div", "jv-sys-d",
      `Faltan ${num(peor.falta)} de ${peor.hasta} temas para ${peor.txt} · ${peor.fecha.setLocale("es").toFormat("d LLL")} (${num(peor.sem)} sem)`);
  }
};

// ---------- Semana en curso (navegable) ----------
// Lunes a domingo: tutorías (CFG), repasos (proximo_repaso de las notas de tema) y fechas del Calendario.
// Los repasos atrasados se muestran en el día de hoy. Con ◀ ▶ se pasa de semana; HOY vuelve a la actual.
// El desplazamiento se guarda en window para que no se pierda cuando Dataview repinta la vista.
const modSemana = (parent) => {
  const fmt = (d) => d.setLocale("es").toFormat("d LLL");
  const b = panel(parent, "SEMANA EN CURSO", "jv-a-sem", " ");
  const cab = b.parentElement;
  const tit = cab.querySelector(".jv-panel-t"), rango = cab.querySelector(".jv-panel-x");
  const nav = el(b, "div", "jv-sem-nav");
  const prev = el(nav, "button", "jv-sem-btn", "◀");
  const hoyB = el(nav, "button", "jv-sem-btn jv-sem-hoy", "HOY");
  const next = el(nav, "button", "jv-sem-btn", "▶");
  const lista = el(b, "div", "jv-sem-lista");
  const pintar = () => {
    const off = window.jvSemOffset || 0;
    const lunes = HOY.startOf("week").plus({ weeks: off });
    tit.setText(off === 0 ? "SEMANA EN CURSO" : off === 1 ? "SEMANA QUE VIENE" : off === -1 ? "SEMANA PASADA" : `SEMANA ${off > 0 ? "+" : "−"}${Math.abs(off)}`);
    rango.setText(`${fmt(lunes)} – ${fmt(lunes.plus({ days: 6 }))}`.toUpperCase());
    hoyB.toggleClass("jv-off", off === 0);
    lista.empty();
    for (let i = 0; i < 7; i++) {
      const dia = lunes.plus({ days: i });
      const n = diasHasta(dia);
      const fila = el(lista, "div", "jv-dia");
      fila.toggleClass("jv-hoy", n === 0);
      fila.toggleClass("jv-pasado", n < 0);
      const f = el(fila, "div", "jv-dia-f");
      el(f, "span", null, dia.setLocale("es").toFormat("ccc").replace(".", "").toUpperCase());
      el(f, "b", null, dia.day);
      const items = [];
      for (const t of CFG.tutorias.filter((t) => t.dia === i + 1)) items.push({ k: t.asig, txt: `Tutoría ${t.ini}-${t.fin}` });
      const reps = temas.where((p) => p.proximo_repaso && (diasHasta(p.proximo_repaso) === n || (n === 0 && diasHasta(p.proximo_repaso) < 0)));
      for (const p of reps) {
        const tarde = diasHasta(p.proximo_repaso) < 0;
        items.push({ k: claveDe(p.asignatura), txt: `Repaso tema ${p.tema}${tarde ? " (atrasado)" : ""}`, ruta: p.file.path, cls: tarde ? "jv-late" : null });
      }
      for (const t of tareas.where((t) => diasHasta(t.fecha) === n)) {
        items.push({ k: asigDeTexto(t.text), txt: limpiar(t.text), ruta: "PLANIFICACION/Calendario", cls: "jv-ev-fecha" });
      }
      const ev = el(fila, "div", "jv-dia-ev");
      if (!items.length) el(ev, "span", "jv-dim", "—");
      for (const it of items) {
        const c = el(ev, "div", `jv-ev ${it.cls || ""}`);
        el(c, "span", "jv-ev-k", it.k || "UNED").style.color = it.k ? CFG.asig[it.k].color : "var(--dim)";
        if (it.ruta) enlace(c, it.ruta, it.txt); else el(c, "span", null, it.txt);
      }
    }
  };
  const mover = (d) => { window.jvSemOffset = d === 0 ? 0 : (window.jvSemOffset || 0) + d; pintar(); };
  prev.onclick = () => mover(-1);
  next.onclick = () => mover(1);
  hoyB.onclick = () => mover(0);
  pintar();
};

// ---------- Mapa de calor de actividad ----------
// Últimas semanas (columnas) × lunes a domingo (filas). Cada día suma: notas de las asignaturas
// creadas o editadas ese día, repasos hechos (ultimo_repaso, valen 2) y tareas marcadas en la nota diaria.
const modCalor = (parent) => {
  const SEMANAS = 16;
  const act = new Map(); // "yyyy-MM-dd" → { notas, repasos, tareas }
  const sumar = (fecha, campo, n = 1) => {
    const k = fecha.toFormat("yyyy-MM-dd");
    const d = act.get(k) || { notas: 0, repasos: 0, tareas: 0 };
    d[campo] += n;
    act.set(k, d);
  };
  const carpetas = claves.map((k) => CFG.asig[k].carpeta + "/");
  for (const f of app.vault.getMarkdownFiles().filter((f) => carpetas.some((c) => f.path.startsWith(c)))) {
    const crea = dv.luxon.DateTime.fromMillis(f.stat.ctime), edita = dv.luxon.DateTime.fromMillis(f.stat.mtime);
    sumar(crea, "notas");
    if (!edita.hasSame(crea, "day")) sumar(edita, "notas");
  }
  for (const p of temas.where((p) => p.ultimo_repaso && p.ultimo_repaso.toFormat)) sumar(p.ultimo_repaso, "repasos");
  for (const d of dv.pages(`"${RUTA_DIARIO}"`).where((p) => p.fecha && p.fecha.toFormat)) {
    const hechas = d.file.tasks.where((t) => t.completed).length;
    if (hechas) sumar(d.fecha, "tareas", hechas);
  }
  const puntos = (d) => (d ? d.notas + 2 * d.repasos + d.tareas : 0);
  const nivel = (n) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4);

  // Racha: días seguidos con actividad hasta hoy (si hoy aún no hay nada, cuenta desde ayer)
  let racha = 0;
  for (let d = puntos(act.get(HOY.toFormat("yyyy-MM-dd"))) ? HOY : HOY.minus({ days: 1 }); puntos(act.get(d.toFormat("yyyy-MM-dd"))); d = d.minus({ days: 1 })) racha++;
  let activos30 = 0;
  for (let i = 0; i < 30; i++) if (puntos(act.get(HOY.minus({ days: i }).toFormat("yyyy-MM-dd")))) activos30++;

  const b = panel(parent, "ACTIVIDAD", "jv-a-calor", `${SEMANAS} SEMANAS`);
  const st = el(b, "div", "jv-stats");
  const dato = (etq, n) => { const s = el(st, "span", null, `${etq} `); el(s, "b", null, n); };
  dato("RACHA", `${racha} d`);
  dato("ACTIVOS (30 d)", activos30);

  const rej = el(b, "div", "jv-calor");
  rej.style.gridTemplateColumns = `auto repeat(${SEMANAS}, 1fr)`;
  const inicio = HOY.startOf("week").minus({ weeks: SEMANAS - 1 });
  // Fila de meses: el nombre aparece en la semana en que empieza el mes
  el(rej, "span");
  for (let w = 0; w < SEMANAS; w++) {
    const lunes = inicio.plus({ weeks: w });
    const nuevo = w === 0 || lunes.month !== lunes.minus({ weeks: 1 }).month;
    el(rej, "span", "jv-calor-mes", nuevo ? lunes.setLocale("es").toFormat("LLL").replace(".", "").toUpperCase() : "");
  }
  for (let fila = 0; fila < 7; fila++) {
    el(rej, "span", "jv-calor-dia", ["L", "", "X", "", "V", "", "D"][fila]);
    for (let w = 0; w < SEMANAS; w++) {
      const dia = inicio.plus({ weeks: w, days: fila });
      const n = diasHasta(dia);
      const d = act.get(dia.toFormat("yyyy-MM-dd"));
      const c = el(rej, "span", `jv-calor-c jv-n${nivel(puntos(d))}`);
      if (n > 0) { c.addClass("jv-futuro"); continue; }
      if (n === 0) c.addClass("jv-hoy");
      const partes = d ? [d.notas && `${d.notas} nota${d.notas > 1 ? "s" : ""}`, d.repasos && `${d.repasos} repaso${d.repasos > 1 ? "s" : ""}`,
        d.tareas && `${d.tareas} tarea${d.tareas > 1 ? "s" : ""}`].filter(Boolean) : [];
      c.title = `${dia.setLocale("es").toFormat("cccc d LLL")}: ${partes.length ? partes.join(", ") : "sin actividad"}`;
    }
  }
  const ley = el(b, "div", "jv-calor-ley");
  el(ley, "span", null, "MENOS");
  for (let i = 0; i <= 4; i++) el(ley, "span", `jv-calor-c jv-n${i}`);
  el(ley, "span", null, "MÁS");
};

// ---------- Sistema planetario de notas con el reactor en el centro ----------
// Planeta central = la máquina (JARVIS): las notas que no son de ninguna asignatura (planificación,
// red neuronal, memoria, libros…) sobre una esfera 3D con retícula, anillos, partículas y rayos de datos.
// Tres lunas = las asignaturas: cada una es una esfera pequeña con sus notas, orbita alrededor del
// planeta y está unida a él por un haz de datos con pulsos en los dos sentidos (la luna envía sus
// notas a la máquina y la máquina le devuelve conocimiento). Los enlaces entre notas son filamentos.
// Gira sola; se puede arrastrar para girarla y se para al pasar el ratón por un nodo.
const modGrafo = (parent) => {
  const caja = el(parent, "div", "jv-graph");
  const canvas = el(caja, "canvas");
  const capa = el(caja, "div", "jv-graph-reactor");
  capa.innerHTML = svgReactor(false); // en el núcleo, sin porcentaje
  animarAnillos(capa);
  const info = el(caja, "div", "jv-graph-info");
  const ley = el(caja, "div", "jv-graph-ley");
  // Zoom del sistema: botones en la esquina, rueda del ratón y Ctrl + / Ctrl − / Ctrl 0 con el ratón encima.
  // Se guarda en window para que no se pierda cuando Dataview repinta la vista.
  const ZMIN = 0.35, ZMAX = 3;
  const zoomBox = el(caja, "div", "jv-zoom");
  const bMas = el(zoomBox, "button", "jv-zoom-b", "+");
  const zTxt = el(zoomBox, "span", "jv-zoom-v");
  const bMenos = el(zoomBox, "button", "jv-zoom-b", "−");
  const bReset = el(zoomBox, "button", "jv-zoom-b jv-zoom-r", "⟲");
  bMas.title = "Acercar (Ctrl +)"; bMenos.title = "Alejar (Ctrl −)"; bReset.title = "Tamaño normal (Ctrl 0)";
  const zoom = () => window.jvZoom || 1;
  const ponerZoom = (z) => {
    window.jvZoom = Math.max(ZMIN, Math.min(ZMAX, Math.round(z * 100) / 100));
    zTxt.setText(`${Math.round(zoom() * 100)}%`);
    if (W) medir();
  };
  for (const k of claves) {
    const s = el(ley, "span");
    el(s, "span", "jv-dot").style.color = CFG.asig[k].color;
    s.appendText(`${k} ${progreso.find((x) => x.k === k).pct}%`);
  }
  for (const [c, color] of Object.entries(CFG.otrasCarpetas)) {
    const s = el(ley, "span");
    el(s, "span", "jv-dot").style.color = color;
    s.appendText(c);
  }

  // Nodos: todas las notas + los archivos enlazados (PDF, etc.)
  const estadoDe = new Map(temas.array().map((p) => [p.file.path, p.estado]));
  const colorDe = (path) => {
    const top = path.includes("/") ? path.split("/")[0] : "";
    const k = claves.find((k) => CFG.asig[k].carpeta === top);
    return k ? CFG.asig[k].color : CFG.otrasCarpetas[top] || "#7fa9b8";
  };
  const nodos = new Map();
  const add = (path) => {
    if (path.startsWith("PLANIFICACION/Jarvis/")) return null;
    if (!nodos.has(path)) {
      const f = app.vault.getAbstractFileByPath(path);
      if (!f) return null;
      nodos.set(path, {
        path, nombre: f.basename, ext: f.extension, carpeta: f.parent ? f.parent.path : "",
        color: colorDe(path), estado: estadoDe.get(path), vecinos: new Set(),
      });
    }
    return nodos.get(path);
  };
  for (const f of app.vault.getMarkdownFiles()) add(f.path);
  const aristas = [];
  for (const [src, dsts] of Object.entries(app.metadataCache.resolvedLinks)) {
    const a = add(src);
    if (!a) continue;
    for (const dst of Object.keys(dsts)) {
      const b = dst !== src ? add(dst) : null;
      if (!b || a.vecinos.has(b)) continue;
      a.vecinos.add(b); b.vecinos.add(a);
      aristas.push([a, b]);
    }
  }
  const lista = [...nodos.values()].sort((a, b) => a.path.localeCompare(b.path));
  const asigDeRuta = (path) => claves.find((k) => path.startsWith(CFG.asig[k].carpeta + "/"));
  for (const n of lista) n.luna = asigDeRuta(n.path) || null;

  // ---------- Geometría (unidades: radio de la esfera = 1) ----------
  let sem = 11;
  const rnd = () => (sem = (sem * 16807) % 2147483647) / 2147483647;
  const fib = (i, n) => {
    const y = 1 - (2 * (i + 0.5)) / n, r = Math.sqrt(1 - y * y), th = i * Math.PI * (3 - Math.sqrt(5));
    return [Math.cos(th) * r, y, Math.sin(th) * r];
  };
  // Lunas: una por asignatura, con su órbita, inclinación, velocidad y giro propio
  const R_LUNA = 0.34;
  // Cada luna tiene su propia órbita: radio (a, b → elipse), inclinación, velocidad y sentido.
  // Periodos de unos 18-30 s para que se vea que se mueven por su cuenta.
  const ORBITAS = [
    { a: 1.75, b: 1.6, incX: 0.45, incZ: -0.2, vel: 0.34 },
    { a: 2.15, b: 1.95, incX: -0.3, incZ: 0.35, vel: -0.24 },
    { a: 2.5, b: 2.25, incX: 0.15, incZ: 0.55, vel: 0.2 },
  ];
  const lunas = claves.map((k, i) => ({
    k, color: CFG.asig[k].color, pct: progreso.find((x) => x.k === k).pct,
    fase: (i / claves.length) * Math.PI * 2, ...ORBITAS[i % ORBITAS.length], giro: 0.5 + rnd() * 0.4,
    polvo: Array.from({ length: 120 }, (_, j) => fib(j, 120)),
    pulsos: Array.from({ length: 6 }, (_, j) => ({ u: j / 6, sube: j % 2 === 0 })),
  }));
  const lunaDe = Object.fromEntries(lunas.map((m) => [m.k, m]));
  // Posición local de cada nota en su cuerpo (radio 1); el radio y el centro se aplican al dibujar
  const repartir = (ns) => ns.forEach((n, i) => {
    const [x, y, z] = fib(i, ns.length), k = 0.97 + rnd() * 0.06;
    n.p = [x * k, y * k, z * k];
  });
  repartir(lista.filter((n) => !n.luna));
  for (const m of lunas) repartir(lista.filter((n) => n.luna === m.k));
  lista.forEach((n) => {
    n.r = (n.ext === "md" ? 3.2 : 2.2) + Math.min(5, Math.sqrt(n.vecinos.size) * 1.3) + (n.estado ? 1.5 : 0);
    if (n.luna) n.r *= 0.75;
  });
  // Partículas: polvo sobre la superficie y algunas dentro
  const polvo = [];
  for (let i = 0; i < 650; i++) { const [x, y, z] = fib(i, 650), k = 1 + (rnd() - 0.5) * 0.04; polvo.push([x * k, y * k, z * k]); }
  for (let i = 0; i < 220; i++) { const [x, y, z] = fib(Math.floor(rnd() * 650), 650), k = 0.35 + rnd() * 0.55; polvo.push([x * k, y * k, z * k]); }
  // Retícula: meridianos y paralelos
  const reticula = [];
  for (let m = 0; m < 8; m++) {
    const lon = (m / 8) * Math.PI, pts = [];
    for (let i = 0; i <= 64; i++) { const lat = (i / 64) * Math.PI * 2; pts.push([Math.cos(lat) * Math.cos(lon), Math.sin(lat), Math.cos(lat) * Math.sin(lon)]); }
    reticula.push(pts);
  }
  for (const lat of [-0.6, -0.3, 0, 0.3, 0.6]) {
    const pts = [], r = Math.cos(lat), y = Math.sin(lat);
    for (let i = 0; i <= 64; i++) { const a = (i / 64) * Math.PI * 2; pts.push([Math.cos(a) * r, y, Math.sin(a) * r]); }
    reticula.push(pts);
  }
  // Anillos orbitales: brillantes, de bloques de datos y finos; cada uno con su inclinación y velocidad
  const TIPOS = ["luz", "datos", "datos", "fino", "luz", "datos", "fino", "fino"];
  const anillos = TIPOS.map((tipo, i) => ({
    tipo, rad: 1.08 + rnd() * 0.24, incX: (rnd() - 0.5) * 2.4, incZ: (rnd() - 0.5) * 2.4,
    vel: (rnd() < 0.5 ? -1 : 1) * (0.05 + rnd() * 0.2), fase: rnd() * 6.3,
    huecos: Array.from({ length: 96 }, () => rnd() < (tipo === "datos" ? 0.45 : 0.08)),
    color: i % 4 === 3 ? "#4dffb5" : "#3ee8ff",
  }));
  // Rayos de datos que salen de la esfera
  const rayos = Array.from({ length: 110 }, (_, i) => {
    const d = fib(i, 110), ini = 1.04 + rnd() * 0.06;
    return { d, ini, fin: ini + 0.08 + rnd() * rnd() * 0.55, fase: rnd() };
  });

  const infoBase = `NÚCLEO + ${lunas.length} LUNAS · NODOS ${lista.length} · ENLACES ${aristas.length} · ARRASTRA PARA GIRAR · PASA EL RATÓN POR UN NODO`;
  info.setText(infoBase);

  // ---------- Proyección ----------
  const ctx = canvas.getContext("2d");
  let W = 0, H = 0, dpr = 1, S = 100, ladoReactor = 0;
  let yaw = 0.6, pitch = -0.32, hover = null, arrastre = null;
  const paquetes = [];
  const rotar = ([x, y, z], ax, az) => { // inclinación propia de un anillo
    let c = Math.cos(ax), s = Math.sin(ax);
    [y, z] = [y * c - z * s, y * s + z * c];
    c = Math.cos(az); s = Math.sin(az);
    return [x * c - y * s, x * s + y * c, z];
  };
  const proy = ([x, y, z]) => { // → [x, y, profundidad 0 (detrás) … 1 (delante), escala]
    let c = Math.cos(yaw), s = Math.sin(yaw);
    const x1 = x * c - z * s, z1 = x * s + z * c;
    c = Math.cos(pitch); s = Math.sin(pitch);
    const y1 = y * c - z1 * s, z2 = y * s + z1 * c;
    const f = 7 / (7 - z2);
    return [W / 2 + x1 * f * S, H / 2 + y1 * f * S, Math.max(0, Math.min(1, (z2 + 1.1) / 2.2)), f];
  };

  const medir = () => {
    if (MODO === "nucleo") {
      const vc = root.closest(".view-content") || root.parentElement;
      const otros = root.offsetHeight - caja.offsetHeight;
      caja.style.height = `${Math.max(380, vc.clientHeight - otros - 40)}px`;
    }
    W = caja.clientWidth; H = caja.clientHeight; dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = `${W}px`; canvas.style.height = `${H}px`;
    S = Math.min(W / 6.2, H / 3.6) * zoom();
  };
  const ro = new ResizeObserver(medir);
  ro.observe(caja);
  const vc = root.closest(".view-content");
  if (vc) ro.observe(vc);

  // Polilínea 3D en dos pasadas (detrás tenue, delante intensa) para no partirla en mil trazos
  const trazo = (pts, color, ancho, aDetras, aDelante, brillo, saltar) => {
    const P = pts.map(proy);
    for (const delante of [false, true]) {
      ctx.beginPath();
      for (let i = 1; i < P.length; i++) {
        if (saltar && saltar[i % saltar.length]) continue;
        const a = P[i - 1], b = P[i];
        if ((a[2] + b[2] > 1) !== delante) continue;
        ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]);
      }
      ctx.globalAlpha = delante ? aDelante : aDetras;
      ctx.strokeStyle = color; ctx.lineWidth = ancho;
      ctx.shadowColor = color; ctx.shadowBlur = delante ? brillo : 0;
      ctx.stroke();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };

  // ---------- Lunas ----------
  const giraY = ([x, y, z], a) => { const c = Math.cos(a), s = Math.sin(a); return [x * c - z * s, y, x * s + z * c]; };
  const centroLuna = (m, t) => {
    const a = m.fase + t * m.vel;
    return rotar([Math.cos(a) * m.a, 0, Math.sin(a) * m.b], m.incX, m.incZ);
  };
  const enLuna = (m, q, t) => { // punto local (radio 1) → mundo
    const l = giraY(q, t * m.giro);
    return [m.c[0] + l[0] * R_LUNA, m.c[1] + l[1] * R_LUNA, m.c[2] + l[2] * R_LUNA];
  };
  const retLuna = [];
  for (let mm = 0; mm < 4; mm++) {
    const lon = (mm / 4) * Math.PI, pts = [];
    for (let i = 0; i <= 40; i++) { const lat = (i / 40) * Math.PI * 2; pts.push([Math.cos(lat) * Math.cos(lon), Math.sin(lat), Math.cos(lat) * Math.sin(lon)]); }
    retLuna.push(pts);
  }
  for (const lat of [-0.5, 0, 0.5]) {
    const pts = [], r = Math.cos(lat), y = Math.sin(lat);
    for (let i = 0; i <= 40; i++) { const a = (i / 40) * Math.PI * 2; pts.push([Math.cos(a) * r, y, Math.sin(a) * r]); }
    retLuna.push(pts);
  }
  const dibujarOrbitas = () => {
    ctx.setLineDash([3, 6]);
    for (const m of lunas) {
      const pts = [];
      for (let i = 0; i <= 120; i++) { const a = (i / 120) * Math.PI * 2; pts.push(rotar([Math.cos(a) * m.a, 0, Math.sin(a) * m.b], m.incX, m.incZ)); }
      trazo(pts, m.color, 0.8, 0.07, 0.25, 0);
    }
    ctx.setLineDash([]);
  };
  // Haz de datos luna ↔ planeta: línea con pulsos que suben a la máquina (color de la asignatura) y bajan (cian)
  const dibujarHaz = (m) => {
    const len = Math.hypot(...m.c), dir = m.c.map((v) => v / len);
    const ini = dir.map((v) => v * 1.02), fin = dir.map((v) => v * (len - R_LUNA * 1.05));
    const pts = Array.from({ length: 13 }, (_, i) => ini.map((v, j) => v + (fin[j] - v) * (i / 12)));
    trazo(pts, m.color, 2.4, 0.12, 0.35, 10);
    trazo(pts, "#ffffff", 0.6, 0.15, 0.5, 0);
    for (const q of m.pulsos) {
      q.u = (q.u + 0.006) % 1;
      const p = proy(fin.map((v, j) => v + (ini[j] - v) * (q.sube ? q.u : 1 - q.u)));
      ctx.globalAlpha = 0.35 + 0.65 * p[2];
      ctx.fillStyle = q.sube ? m.color : "#cdf6ff";
      ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 10;
      ctx.beginPath(); ctx.arc(p[0], p[1], 2.2 * p[3], 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
  };
  const dibujarLuna = (m, t) => {
    const [cx, cy, cz, cf] = proy(m.c), rr = R_LUNA * S * cf;
    const g = ctx.createRadialGradient(cx, cy, rr * 0.2, cx, cy, rr * 2.2);
    g.addColorStop(0, m.color + "33"); g.addColorStop(0.45, m.color + "14"); g.addColorStop(1, m.color + "00");
    ctx.fillStyle = g; ctx.globalAlpha = 0.5 + 0.5 * cz;
    ctx.beginPath(); ctx.arc(cx, cy, rr * 2.2, 0, Math.PI * 2); ctx.fill();
    ctx.globalAlpha = 1;
    for (const pts of retLuna) trazo(pts.map((q) => enLuna(m, q, t)), m.color, 0.7, 0.08, 0.3, 4);
    ctx.globalAlpha = 0.25 + 0.5 * cz; ctx.strokeStyle = m.color; ctx.lineWidth = 1.2;
    ctx.shadowColor = m.color; ctx.shadowBlur = 12;
    ctx.beginPath(); ctx.arc(cx, cy, rr, 0, Math.PI * 2); ctx.stroke();
    // anillo con el progreso de la asignatura
    ctx.lineWidth = 2.4; ctx.globalAlpha = 0.6 + 0.4 * cz;
    ctx.beginPath(); ctx.arc(cx, cy, rr + 6, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (m.pct / 100)); ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.fillStyle = m.color;
    for (const q of m.polvo) {
      const p = proy(enLuna(m, q, t));
      ctx.globalAlpha = 0.06 + 0.4 * p[2] * p[2];
      ctx.fillRect(p[0] - 0.6, p[1] - 0.6, 1.2, 1.2);
    }
    ctx.globalAlpha = 0.55 + 0.45 * cz;
    ctx.font = "bold 12px Orbitron, 'Share Tech Mono', monospace"; ctx.textAlign = "center";
    ctx.fillStyle = m.color; ctx.shadowColor = m.color; ctx.shadowBlur = 8;
    ctx.fillText(`${m.k} · ${m.pct}%`, cx, cy - rr - 14);
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  };

  const dibujar = () => {
    const t = performance.now() / 1000;
    for (const m of lunas) m.c = centroLuna(m, t);
    const detras = lunas.filter((m) => proy(m.c)[2] < 0.5), delante = lunas.filter((m) => !detras.includes(m));
    if (!arrastre && !hover) yaw += 0.0025;
    const lado = Math.round(S * 0.62);
    if (lado !== ladoReactor) { ladoReactor = lado; capa.style.width = capa.style.height = `${lado}px`; }

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    const g = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, S * 1.6);
    g.addColorStop(0, "rgba(62,232,255,.10)"); g.addColorStop(1, "rgba(62,232,255,0)");
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    dibujarOrbitas();
    for (const m of detras) { dibujarHaz(m); dibujarLuna(m, t); }
    // Retícula
    for (const pts of reticula) trazo(pts, "#3ee8ff", 0.7, 0.04, 0.12, 0);
    // Rayos de datos (con un pulso que sale hacia fuera)
    ctx.setLineDash([2, 3]);
    for (const delante of [false, true]) {
      ctx.beginPath();
      for (const r of rayos) {
        const a = proy(r.d.map((v) => v * r.ini)), b = proy(r.d.map((v) => v * r.fin));
        if ((a[2] > 0.5) !== delante) continue;
        ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]);
      }
      ctx.globalAlpha = delante ? 0.55 : 0.15; ctx.strokeStyle = "#3ee8ff"; ctx.lineWidth = 1.2; ctx.stroke();
    }
    ctx.setLineDash([]);
    ctx.fillStyle = "#cdf6ff";
    for (const r of rayos) {
      const u = (t * 0.35 + r.fase) % 1, k = r.ini + (r.fin - r.ini) * u;
      const p = proy(r.d.map((v) => v * k));
      ctx.globalAlpha = (1 - u) * (0.2 + 0.8 * p[2]);
      ctx.fillRect(p[0] - 1, p[1] - 1, 2, 2);
    }
    // Partículas
    for (const q of polvo) {
      const p = proy(q);
      ctx.globalAlpha = 0.08 + 0.5 * p[2] * p[2];
      ctx.fillStyle = "#3ee8ff";
      ctx.fillRect(p[0] - 0.7, p[1] - 0.7, 1.4 * p[3], 1.4 * p[3]);
    }
    ctx.globalAlpha = 1;
    // Anillos orbitales
    for (const a of anillos) {
      const giro = a.fase + t * a.vel, pts = [];
      for (let i = 0; i <= 96; i++) {
        const ang = giro + (i / 96) * Math.PI * 2;
        pts.push(rotar([Math.cos(ang) * a.rad, 0, Math.sin(ang) * a.rad], a.incX, a.incZ));
      }
      if (a.tipo === "luz") trazo(pts, a.color, 2.2, 0.18, 0.9, 14);
      else if (a.tipo === "datos") trazo(pts, a.color, 4, 0.1, 0.55, 6, a.huecos);
      else trazo(pts, a.color, 0.8, 0.08, 0.35, 0);
    }
    for (const m of delante) { dibujarHaz(m); dibujarLuna(m, t); }

    // Proyección de las notas
    for (const n of lista) [n.sx, n.sy, n.z, n.f] = proy(n.luna ? enLuna(lunaDe[n.luna], n.p, t) : n.p);
    const resaltados = hover ? new Set([hover, ...hover.vecinos]) : null;
    // Filamentos (enlaces) atravesando la esfera
    for (const [a, b] of aristas) {
      const on = hover && (a === hover || b === hover);
      const prof = (a.z + b.z) / 2;
      ctx.globalAlpha = on ? 0.95 : resaltados ? 0.04 : 0.08 + 0.3 * prof;
      ctx.strokeStyle = on ? "#ffffff" : a.color; ctx.lineWidth = on ? 1.4 : 0.8;
      ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
    }
    // Paquetes de datos por los enlaces
    if (aristas.length && Math.random() < 0.2 && paquetes.length < 24) {
      const e = aristas[Math.floor(Math.random() * aristas.length)];
      paquetes.push({ e: Math.random() < 0.5 ? e : [e[1], e[0]], t: 0 });
    }
    ctx.fillStyle = "rgba(220,255,255,.95)"; ctx.shadowColor = "#3ee8ff"; ctx.shadowBlur = 8;
    for (let i = paquetes.length - 1; i >= 0; i--) {
      const p = paquetes[i];
      p.t += 0.015;
      if (p.t >= 1) { paquetes.splice(i, 1); continue; }
      const [a, b] = p.e;
      ctx.globalAlpha = 0.3 + 0.7 * ((a.z + b.z) / 2);
      ctx.beginPath(); ctx.arc(a.sx + (b.sx - a.sx) * p.t, a.sy + (b.sy - a.sy) * p.t, 1.6, 0, Math.PI * 2); ctx.fill();
    }
    // Nodos, de atrás hacia delante
    for (const n of [...lista].sort((a, b) => a.z - b.z)) {
      const tenue = resaltados && !resaltados.has(n);
      ctx.globalAlpha = tenue ? 0.12 : 0.25 + 0.75 * n.z;
      const r = n.r * n.f;
      ctx.shadowColor = n.color; ctx.shadowBlur = n === hover ? 24 : 6 + 10 * n.z;
      ctx.fillStyle = n.ext === "md" ? n.color : "rgba(127,169,184,.8)";
      ctx.beginPath(); ctx.arc(n.sx, n.sy, r, 0, Math.PI * 2); ctx.fill();
      if (n.estado) { // anillo con el estado del tema
        ctx.shadowBlur = 0; ctx.strokeStyle = n.color; ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.arc(n.sx, n.sy, r + 3.5, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * (PESO[n.estado] ?? 0)); ctx.stroke();
      }
    }
    // Etiquetas: las notas de delante con más enlaces o con estado, y las del nodo señalado
    ctx.shadowBlur = 0;
    ctx.font = "11px 'Share Tech Mono', Consolas, monospace";
    ctx.textAlign = "center";
    for (const n of lista) {
      const ver = resaltados ? resaltados.has(n) : n.z > 0.6 && n.ext === "md" && (n.vecinos.size >= 3 || n.estado);
      if (!ver) continue;
      ctx.globalAlpha = resaltados ? 1 : Math.min(1, (n.z - 0.6) * 3);
      ctx.fillStyle = n === hover ? "#ffffff" : "rgba(205,246,255,.8)";
      const txt = n.nombre.length > 30 ? n.nombre.slice(0, 29) + "…" : n.nombre;
      ctx.fillText(txt, n.sx, n.sy + n.r * n.f + 13);
    }
    ctx.globalAlpha = 1;
  };

  const bucle = () => {
    if (!root.isConnected) { ro.disconnect(); return; }
    if (W && H) dibujar();
    requestAnimationFrame(bucle);
  };

  // Ratón: señalar, abrir y arrastrar para girar
  canvas.addEventListener("mousedown", (e) => { arrastre = { x: e.clientX, y: e.clientY, movido: 0 }; });
  canvas.addEventListener("mouseup", () => { setTimeout(() => { arrastre = null; }, 0); });
  canvas.addEventListener("mousemove", (e) => {
    if (arrastre && e.buttons) {
      const dx = e.clientX - arrastre.x, dy = e.clientY - arrastre.y;
      arrastre.movido += Math.abs(dx) + Math.abs(dy);
      arrastre.x = e.clientX; arrastre.y = e.clientY;
      yaw += dx * 0.008;
      pitch = Math.max(-1.3, Math.min(1.3, pitch + dy * 0.008));
      canvas.style.cursor = "grabbing";
      return;
    }
    const r = canvas.getBoundingClientRect();
    const mx = e.clientX - r.left, my = e.clientY - r.top;
    let mejor = null, dmin = Infinity;
    for (const n of lista) {
      if (n.z < 0.4) continue; // solo los de la cara visible
      const d = Math.hypot(n.sx - mx, n.sy - my);
      if (d < Math.max(8, n.r * n.f + 4) && d < dmin) { mejor = n; dmin = d; }
    }
    if (mejor !== hover) {
      hover = mejor;
      info.setText(hover
        ? `▸ ${hover.nombre}${hover.ext !== "md" ? "." + hover.ext : ""} · ${hover.carpeta || "raíz"} · ENLACES ${hover.vecinos.size}${hover.estado ? " · ESTADO " + hover.estado.toUpperCase() : ""}`
        : infoBase);
    }
    canvas.style.cursor = hover ? "pointer" : "grab";
  });
  canvas.addEventListener("mouseleave", () => { hover = null; arrastre = null; info.setText(infoBase); });
  bMas.onclick = () => ponerZoom(zoom() * 1.2);
  bMenos.onclick = () => ponerZoom(zoom() / 1.2);
  bReset.onclick = () => ponerZoom(1);
  canvas.addEventListener("wheel", (e) => { e.preventDefault(); ponerZoom(zoom() * (e.deltaY < 0 ? 1.1 : 1 / 1.1)); }, { passive: false });
  // Ctrl + / − / 0 solo cuando el ratón está sobre el núcleo (fuera de él, Obsidian hace su zoom normal)
  let dentro = false;
  caja.addEventListener("mouseenter", () => { dentro = true; });
  caja.addEventListener("mouseleave", () => { dentro = false; });
  const teclas = (e) => {
    if (!root.isConnected) { window.removeEventListener("keydown", teclas, true); return; }
    if (!dentro || !(e.ctrlKey || e.metaKey)) return;
    const k = e.key;
    if (k === "+" || k === "=" || k === "Add") ponerZoom(zoom() * 1.2);
    else if (k === "-" || k === "Subtract") ponerZoom(zoom() / 1.2);
    else if (k === "0") ponerZoom(1);
    else return;
    e.preventDefault(); e.stopPropagation();
  };
  window.addEventListener("keydown", teclas, true);
  ponerZoom(zoom());
  canvas.addEventListener("click", (e) => {
    if (arrastre && arrastre.movido > 4) return; // era un arrastre, no un clic
    if (hover) abrir(hover.path, e.ctrlKey || e.metaKey);
  });

  setTimeout(() => { medir(); bucle(); }, 30);
};

// ---------- Montaje según el modo ----------
if (MODO === "nucleo") {
  modCabecera(root);
  modGrafo(root);
} else if (MODO === "izquierda") {
  modBriefing(root);
  modTutoria(root);
  modSistemas(root);
  modRepasos(root);
  modSemana(root);
  modCalor(root);
} else if (MODO === "derecha") {
  modPrioridades(root);
  modObjetivos(root);
  modRitmo(root);
  modPomodoro(root);
  modRegistro(root);
} else {
  modCabecera(root);
  const grid = el(root, "div", "jv-grid");
  modBriefing(grid);
  modReactor(grid);
  modTutoria(grid);
  modSistemas(grid);
  modPomodoro(grid);
  modObjetivos(grid);
  modRepasos(grid);
  modRegistro(grid);
}

// ---------- Bucle de 1 s ----------
const tick = () => {
  if (!root.isConnected) {
    clearInterval(intervalo);
    // Si ya no queda ninguna vista JARVIS abierta, se devuelve la interfaz normal
    if (!document.querySelector(".jv-m-nucleo, .jv-m-izquierda, .jv-m-derecha") && document.body.hasClass("jv-mode")) {
      document.body.removeClass("jv-mode");
      temaTerminal(false);
    }
    return;
  }
  // Pestañas de terminal nuevas, o Lean Terminal que repinta con su tema al cambiar el de Obsidian
  if (MODO === "nucleo" && document.body.hasClass("jv-mode")) temaTerminal(true);
  ticks.forEach((f) => f());
};
const intervalo = setInterval(tick, 1000);
tick();
